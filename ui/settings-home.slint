import { VectorIcon } from "icons/vector-icons.slint";
import { Theme, AvatarFill } from "theme.slint";

export component SettingsHome inherits Rectangle {
    in property <string> user-name: "Relay Desktop";
    in property <string> user-phone: "+7 999 000-00-00";
    in property <string> user-username: "@relay_desktop";
    in property <string> user-initials: "R";
    in property <image> user-avatar;
    in property <bool> user-has-avatar;
    callback profile-requested();
    callback gifts-changed();
    callback appearance-requested();
    callback folders-requested();
    callback logout-requested();
    in property <[string]> folder-names;
    in property <[int]> folder-counts;
    background: Theme.surface;

    Rectangle {
        x: 22px;
        y: 10px;
        width: 72px;
        height: 72px;
        border-radius: 36px; clip: true;
        AvatarFill {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            top: #72d5fd;
            bottom: #2a9ef1;
        }
        Text {
            width: parent.width;
            height: parent.height;
            text: root.user-initials;
            color: #ffffff;
            font-size: 29px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.user-has-avatar : Image { width: parent.width; height: parent.height; source: root.user-avatar; image-fit: cover; }
        TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { root.profile-requested(); } }
    }
    Text {
        x: 112px;
        y: 16px;
        width: parent.width - 134px;
        text: root.user-name;
        font-size: 16px;
        font-weight: 600;
        color: Theme.ink;
        overflow: elide;
    }
    Text {
        x: 112px;
        y: 41px;
        text: root.user-phone;
        font-size: 13px;
        color: Theme.ink;
    }
    Text {
        x: 112px;
        y: 61px;
        text: root.user-username;
        font-size: 13px;
        color: Theme.muted;
    }
    Rectangle {
        x: 0px;
        y: 96px;
        width: parent.width;
        height: 10px;
        background: Theme.dark ? #202a36 : #f1f1f1;
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 1px;
            background: Theme.border;
        }
        Rectangle {
            x: 0px;
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Theme.border;
        }
    }
    for name[index] in [
        "My Account", "Notifications and Sounds", "Privacy and Security",
        "Chat Settings", "Chat Folders", "Advanced", "Speakers and Camera",
        "Battery and Animations", "Language", "Log Out", "Telegram Gifts"
    ] : Rectangle {
        x: 0px;
        y: 112px + index * 40px;
        width: parent.width;
        height: 40px;
        background: pointer.has-hover ? Theme.hover : transparent;
        VectorIcon {
            x: 23px;
            y: (parent.height - self.height) / 2;
            width: self.natural-width;
            height: self.natural-height;
            name: index == 0 ? "profile"
                : index == 1 ? "notifications"
                : index == 2 ? "privacy"
                : index == 3 ? "chat-settings"
                : index == 4 ? "folder"
                : index == 5 ? "advanced"
                : index == 6 ? "phone"
                : index == 7 ? "power"
                : index == 8 ? "language"
                : "close";
            tint: index == 9 ? #ef5b5b : Theme.menu-icon-fg;
        }
        Text {
            x: 64px;
            width: parent.width - 140px;
            height: parent.height;
            text: name;
            font-size: 13px;
            color: index == 9 ? #ef5b5b : Theme.ink;
            vertical-alignment: center;
        }
        if index == 8 : Text {
            x: parent.width - 100px;
            width: 78px;
            height: parent.height;
            text: "English";
            font-size: 13px;
            color: Theme.accent;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        if index == 10 : Text { x: parent.width - 82px; width: 64px; height: parent.height; text: Theme.show-gifts ? "Вкл." : "Выкл."; color: Theme.accent; vertical-alignment: center; horizontal-alignment: right; }
        pointer := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: index == 3 || index == 4 || index == 9 ? MouseCursor.pointer : MouseCursor.default;
            enabled: index == 0 || index == 3 || index == 4 || index == 9 || index == 10;
            clicked => {
                if index == 0 { root.profile-requested(); }
                else if index == 10 { Theme.show-gifts = !Theme.show-gifts; root.gifts-changed(); }
                else if index == 3 {
                    root.appearance-requested();
                } else if index == 4 {
                    root.folders-requested();
                } else if index == 9 {
                    root.logout-requested();
                }
            }
        }
    }
}
