import { VectorIcon } from "icons/vector-icons.slint";
import { TelegramMotion, Motion, MessageSendMotion, MessageReceiveMotion, PopupReveal, BoxOverlay, RippleSurface } from "motion.slint";
import { ListView } from "list-view.slint";
import { AuthScreen } from "auth.slint";
import { SettingsHome } from "settings-home.slint";
import { ProfilePanel, GiftRow, TelegramProfile } from "profile.slint";
export { GiftRow, TelegramProfile } from "profile.slint";
import { Theme, ActionButton, Entry, Composer, IconButton, MenuItem, AvatarFill, BubbleShape, SendingClock } from "theme.slint";
import "fonts/OpenSans-Regular.ttf";
import "fonts/OpenSans-SemiBold.ttf";
import "fonts/OpenSans-Italic.ttf";
export { Theme } from "theme.slint";
export { TelegramMotion } from "motion.slint";

export struct ChatRow {
    no-photo: bool,
    presence: string,
    online: bool,
    id: int,
    title: string,
    initials: string,
    accent: color,
    accent-top: color,
    preview: string,
    time: string,
    unread: int,
    outgoing: bool,
    last-message-id: int,
    read-outbox-max-id: int,
    folder: int,
    channel-access: int,
    avatar: image,
    has-avatar: bool,
}

export struct MessageRow {
    sender-key: string,
    entities-json: string,
    sender: string,
    reply-author: string,
    reply-body: string,
    reply-external: bool,
    reply-resolved: bool,
    reply-quoted: bool,
    preview: image,
    has-preview: bool,
    preview-failed: bool,
    photo-width: int,
    photo-height: int,
    photo-key: string,
    id: int,
    send-token: int,
    receive-token: int,
    pending: bool,
    failed: bool,
    reply-to: int,
    date: string,
    has-media: bool,
    is-photo: bool,
    body: string,
    formatted-body: styled-text,
    has-formatting: bool,
    time: string,
    outgoing: bool,
    channel-post: bool,
    service: bool,
}

export struct FolderRow {
    id: int,
    title: string,
    unread: int,
}

export struct AttachmentRow { path: string, name: string, size: string }

component Avatar inherits Rectangle {
    in property <string> initials;
    in property <color> tint;
    in property <color> tint-top;
    in property <bool> saved: false;
    in property <image> photo;
    in property <bool> has-photo: false;
    width: 46px;
    height: 46px;
    border-radius: min(self.width, self.height) / 2;
    clip: true;
    if root.has-photo && !root.saved : Image {
        width: parent.width;
        height: parent.height;
        source: root.photo;
        image-fit: cover;
        image-rendering: smooth;
    }
    if !root.has-photo || root.saved : AvatarFill {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        top: root.tint-top;
        bottom: root.tint;
    }
    if root.saved : VectorIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: parent.width * 24 / 46;
        height: parent.height * 24 / 46;
        name: "saved";
        tint: #ffffff;
    }
    if !root.saved && !root.has-photo : Text {
        width: parent.width;
        height: parent.height;
        text: root.initials;
        color: #ffffff;
        font-size: 18px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ChatTile inherits Rectangle {
    in property <ChatRow> chat;
    in property <bool> selected;
    in property <int> row-index: 0;
    in property <length> list-viewport-y: 0px;
    in property <length> list-height: 0px;
    in property <bool> list-visible: true;
    callback avatar-requested(int);
    callback opened();
    height: 62px;
    property <bool> avatar-in-viewport: root.list-visible
        && root.row-index * 62px + root.list-viewport-y < root.list-height
        && (root.row-index + 1) * 62px + root.list-viewport-y > 0px;
    property <int> avatar-request-key: root.avatar-in-viewport && !root.chat.has-avatar && root.chat.id != 3
        ? root.chat.id : 0;
    init => {
        if (root.avatar-request-key != 0) {
            root.avatar-requested(root.avatar-request-key);
        }
    }
    changed avatar-request-key => {
        if (root.avatar-request-key != 0) {
            root.avatar-requested(root.avatar-request-key);
        }
    }
    property <bool> last-message-read: chat.id == 3 || chat.last-message-id <= chat.read-outbox-max-id;
    clip: true;
    property <string> unread-label: chat.unread > 999 ? "999+" : "\{chat.unread}";
    background: transparent;
    accessible-role: button;
    accessible-label: chat.title;
    accessible-action-default => { root.opened(); }
    Rectangle {
        x: Theme.design == 0 ? 0px : 4px;
        y: Theme.design == 0 ? 0px : 3px;
        width: parent.width - (Theme.design == 0 ? 0px : 8px);
        height: parent.height - (Theme.design == 0 ? 0px : 6px);
        border-radius: Theme.design == 0 ? 0px : 10px;
        background: root.selected ? Theme.selected : pointer.has-hover ? Theme.hover : transparent;
    }
    RippleSurface {
        x: Theme.design == 0 ? 0px : 4px;
        y: Theme.design == 0 ? 0px : 3px;
        width: parent.width - (Theme.design == 0 ? 0px : 8px);
        height: parent.height - (Theme.design == 0 ? 0px : 6px);
        border-radius: Theme.design == 0 ? 0px : 10px;
        pressed: pointer.pressed;
        press-x: pointer.mouse-x - self.x;
        press-y: pointer.mouse-y - self.y;
        ink: root.selected ? Theme.selected-dialog-ripple : Theme.dialog-ripple;
    }
    Avatar {
        x: 10px;
        y: 8px;
        visible: root.avatar-in-viewport;
        initials: root.chat.initials;
        tint: root.chat.accent;
        tint-top: root.chat.accent-top;
        saved: root.chat.id == 3;
        photo: root.chat.avatar;
        has-photo: root.chat.has-avatar;
    }
    Text {
        x: 68px;
        y: 10px;
        width: max(0px, time-label.x - self.x - (root.chat.outgoing ? 24px : 5px));
        height: 20px;
        text: root.chat.title;
        color: root.selected ? Theme.selected-ink : Theme.ink;
        font-size: 13px;
        font-weight: 600;
        overflow: elide;
        vertical-alignment: center;
    }
    if root.chat.outgoing && root.chat.channel-access == 0 && root.chat.last-message-id >= 0 && root.last-message-read : VectorIcon {
        x: parent.width - 31px - time-label.preferred-width;
        y: 14px;
        width: self.natural-width;
        height: self.natural-height;
        name: "read";
        tint: root.selected ? Theme.selected-ink : Theme.outgoing-check;
    }
    if root.chat.outgoing && root.chat.channel-access == 0 && root.chat.last-message-id >= 0 && !root.last-message-read : VectorIcon {
        x: parent.width - 31px - time-label.preferred-width;
        y: 14px;
        name: "sent";
        tint: root.selected ? Theme.selected-ink : Theme.outgoing-check;
    }
    if root.chat.outgoing && root.chat.channel-access == 0 && root.chat.last-message-id < 0 : SendingClock {
        x: parent.width - 60px; y: 19px;
        tint: root.selected ? Theme.selected-ink : Theme.muted;
    }
    time-label := Text {
        x: parent.width - self.preferred-width - 10px;
        y: 9px;
        width: self.preferred-width;
        height: 20px;
        text: root.chat.time;
        color: root.selected ? Theme.selected-muted : Theme.muted;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    Text {
        x: 68px;
        y: 34px;
        width: max(0px, parent.width - (root.chat.unread > 0 ? 128px : 80px));
        height: 20px;
        text: root.chat.preview;
        color: root.selected ? Theme.selected-muted : Theme.muted;
        font-size: 13px;
        overflow: elide;
        vertical-alignment: center;
    }
    if root.chat.unread > 0 : Rectangle {
        x: parent.width - self.width - 10px;
        y: 34px;
        width: max(19px, unread-text.preferred-width + 10px);
        height: 19px;
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            border-radius: self.height / 2;
            background: root.selected ? #ffffff : Theme.accent;
        }
        unread-text := Text {
            width: parent.width;
            height: parent.height;
            text: root.unread-label;
            font-size: 12px;
            font-weight: 600;
            color: root.selected ? Theme.selected : #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.opened();
                return accept;
            }
            return reject;
        }
    }
    pointer := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.opened(); }
    }
}

component Bubble inherits Rectangle {
    callback selected(length, length);
    callback photo-requested();
    callback retry-requested();
    callback reply-requested();
    in property <int> focus-token;
    focus-motion := Motion { duration: 900ms; }
    changed focus-token => { if root.focus-token > 0 { focus-motion.restart(1, 0); } }
    in property <float> sending-mix: 1;
    in property <bool> flight-running: false;
    in property <MessageRow> message;
    in property <bool> is-read;
    in property <length> available-width;
    in property <bool> group-start: true;
    in property <bool> group-end: true;
    out property <bool> outgoing: message.outgoing && !message.channel-post;
    property <length> receipt-width: outgoing ? 20px : 0px;
    property <length> date-width: date-measure.preferred-width + receipt-width;
    property <string> display-text: root.message.is-photo && root.message.body == "Фото" ? "" : root.message.body;
    property <styled-text> display-content: root.display-text == "" ? @markdown("") : root.message.has-formatting ? root.message.formatted-body : @markdown("\{root.display-text}");
    out property <length> quote-height: root.message.reply-to > 0 ? 44px : 0px;
    property <length> author-height: !root.outgoing && root.group-start && root.message.sender != "" ? 20px : 0px;
    property <length> photo-height: root.message.is-photo ? clamp((root.body-width - 16px) * max(1, root.message.photo-height) / max(1, root.message.photo-width), 100px, 300px) : 0px;
    property <bool> single-line: !root.message.is-photo && measure.preferred-height <= date-measure.preferred-height + 4px && measure.preferred-width + date-width + 34px <= available-width;
    property <length> body-width: min(max(max(measure.preferred-width + (single-line ? date-width + 34px : 22px), date-width + 34px), max(root.message.is-photo ? 300px : 0px, root.message.reply-to > 0 ? min(320px, quote-measure.preferred-width + 34px) : 0px)), root.available-width);
    property <length> tail-width: root.group-end && Theme.design == 0 ? 6px : 0px;
    property <length> left-pad: !root.outgoing && root.group-end && Theme.design == 0 ? 6px : 0px;
    width: root.body-width + root.tail-width;
    height: root.author-height + max(35px, (root.display-text == "" ? 0px : body.preferred-height) + 16px + (single-line ? 0px : 16px) + root.quote-height + root.photo-height);
    background: transparent;
    BubbleShape {
        opacity: root.sending-mix;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        fill: root.outgoing ? Theme.outgoing : Theme.incoming;
        tail-width: root.tail-width;
        tail: root.group-end && Theme.design == 0 ? (root.outgoing ? 2 : 1) : 0;
    }
    measure := StyledText {
        visible: false;
        text: root.display-content;
        default-font-size: 13px;
        default-font-family: "Open Sans";
    }
    quote-measure := Text { visible: false; text: root.message.reply-author + "\n" + root.message.reply-body; font-size: 13px; }
    Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; border-radius: 8px; background: Theme.accent.transparentize(0.75); opacity: focus-motion.value; }
    if root.message.reply-to > 0 : Rectangle {
        x: root.left-pad + 8px; y: 6px + root.author-height; width: root.body-width - 16px; height: 38px;
        border-radius: 4px; background: Theme.accent.transparentize(0.9); opacity: root.sending-mix;
        Rectangle { x: 1px; y: 1px; width: 2px; height: 36px; background: root.outgoing ? Theme.outgoing-check : Theme.accent; border-radius: 1px; }
        Text { x: 10px; y: 0px; width: parent.width - 15px; height: 19px; text: root.message.reply-author != "" ? root.message.reply-author : "Ответ на сообщение"; font-size: 13px; font-weight: 600; color: root.outgoing ? Theme.outgoing-check : Theme.accent; overflow: elide; }
        Text { x: 10px; y: 19px; width: parent.width - 15px; height: 19px; text: root.message.reply-body != "" ? root.message.reply-body : "Загрузка сообщения…"; font-size: 13px; color: Theme.ink; overflow: elide; }
    }
    if root.message.is-photo : Rectangle {
        x: root.left-pad + 8px; y: 8px + root.quote-height + root.author-height; width: root.body-width - 16px; height: root.photo-height;
        border-radius: 6px; clip: true; background: Theme.canvas;
        if root.message.has-preview : Image { width: parent.width; height: parent.height; source: root.message.preview; image-fit: contain; }
        if !root.message.has-preview : Text { width: parent.width; height: parent.height; text: root.message.preview-failed ? "Открыть фото" : "Загрузка фото…"; color: Theme.muted; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
    }
    date-measure := Text {
        visible: false;
        text: root.message.time;
        font-size: 13px;
    }
    body := StyledText {
        x: root.left-pad + 11px;
        y: 8px + root.quote-height + root.photo-height + root.author-height;
        width: max(1px, root.body-width - 22px - (root.single-line ? root.date-width + 12px : 0px));
        height: self.preferred-height;
        text: root.display-content;
        default-font-size: 13px;
        default-font-family: "Open Sans";
        default-color: Theme.ink;
        link-color: root.outgoing ? Theme.outgoing-check : Theme.accent;
        link-clicked(url) => { Theme.open-link(url); }
    }
    Text {
        x: root.left-pad + root.body-width - root.date-width - 9px;
        opacity: root.sending-mix;
        y: parent.height - 21px;
        width: date-measure.preferred-width;
        height: 18px;
        text: root.message.time;
        color: root.outgoing ? Theme.outgoing-muted : Theme.muted;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    if root.outgoing && !root.message.pending && !root.message.failed && root.is-read : VectorIcon {
        opacity: root.sending-mix;
        x: root.left-pad + root.body-width - 25px;
        y: parent.height - 16px;
        width: self.natural-width;
        height: self.natural-height;
        name: "read";
        tint: Theme.outgoing-check;
    }
    if root.outgoing && !root.message.pending && !root.message.failed && !root.is-read : VectorIcon {
        opacity: root.sending-mix;
        x: root.left-pad + root.body-width - 25px;
        y: parent.height - 16px;
        name: "sent";
        tint: Theme.outgoing-check;
    }
    if root.outgoing && root.message.pending : SendingClock {
        x: root.left-pad + root.body-width - 24px;
        y: parent.height - 18px;
        opacity: root.sending-mix;
        tint: Theme.outgoing-muted;
    }
    if root.message.failed : Text {
        x: root.body-width - 25px; y: parent.height - 22px;
        text: "!"; color: #e85d5d; font-size: 16px; font-weight: 600;
    }
    TouchArea {
        width: parent.width; height: parent.height;
        // Native styled text handles links; the window filter routes right
        // clicks back to the message's context menu before Slint dispatches.
        enabled: !root.flight-running && (!root.message.has-formatting || Theme.context-pointer || root.message.failed);
        mouse-cursor: root.message.is-photo || root.message.failed ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.selected(self.mouse-x, self.mouse-y);
            }
        }
        clicked => {
            if root.message.failed { root.retry-requested(); }
            else if root.message.is-photo { root.photo-requested(); }
        }
    }
    if root.message.is-photo : TouchArea {
        x: root.left-pad + 8px; y: 8px + root.quote-height + root.author-height;
        width: root.body-width - 16px; height: root.photo-height;
        enabled: !root.flight-running; mouse-cursor: pointer;
        clicked => { if root.message.failed { root.retry-requested(); } else { root.photo-requested(); } }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.selected(self.x + self.mouse-x, self.y + self.mouse-y);
            }
        }
    }
    if root.message.reply-to > 0 : TouchArea {
        x: root.left-pad + 8px; y: 6px + root.author-height; width: root.body-width - 16px; height: 38px;
        enabled: !root.flight-running; mouse-cursor: pointer;
        clicked => { root.reply-requested(); }
        pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { root.selected(self.x + self.mouse-x, self.y + self.mouse-y); } }
    }
    if root.author-height > 0px : Rectangle {
        x: root.left-pad + 11px; y: 5px; width: root.body-width - 22px; height: 20px;
        Text { width: parent.width; height: parent.height; text: root.message.sender; color: Theme.accent; font-size: 13px; font-weight: 600; overflow: elide; }
        TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { Theme.open-profile(root.message.sender-key); } }
    }
}

export component Desktop inherits Window {
    in-out property <bool> profile-open;
    in-out property <string> profile-key;
    in-out property <string> profile-name;
    in-out property <string> profile-initials;
    in-out property <string> profile-presence;
    in-out property <bool> profile-is-user;
    in-out property <bool> profile-is-self;
    in-out property <bool> profile-is-bot;
    in-out property <bool> profile-online;
    in-out property <string> profile-birthday;
    in-out property <bool> profile-muted;
    in-out property <bool> profile-mute-ready;
    in-out property <bool> profile-action-busy;
    in-out property <string> profile-gifts-status;
    in-out property <string> profile-link;
    in-out property <string> profile-qr-matrix;
    in-out property <length> profile-scroll-y <=> profile-panel.scroll-y;
    out property <length> profile-header-y: profile-panel.header-y;
    out property <int> profile-gift-columns: profile-panel.gift-columns;
    out property <length> profile-gift-width: profile-panel.gift-width;
    out property <length> profile-header-height: profile-panel.header-height;
    in-out property <bool> photo-from-profile;
    callback profile-action(string);
    in-out property <string> profile-username;
    in-out property <string> profile-phone;
    in-out property <string> profile-about;
    in-out property <image> profile-photo;
    in-out property <bool> profile-has-photo;
    in-out property <[GiftRow]> profile-gifts;
    in-out property <string> profile-status;
    in-out property <string> profile-next;
    in-out property <bool> profile-busy;
    in-out property <image> user-avatar;
    in-out property <bool> user-has-avatar;
    callback more-gifts();
    callback profile-photo-requested();
    in-out property <bool> large-editor-open;
    in-out property <bool> large-editor-dismissed;
    in-out property <string> editor-saved-text;
    callback editor-history(string);
    in property <bool> editor-can-undo;
    in property <bool> editor-can-redo;
    // Growing text stays in the composer; expanding the editor is explicit.
    public function expand-composer() {
        root.editor-saved-text = root.draft;
        root.editor-history("begin");
        root.large-editor-open = true;
        large-composer.focus();
    }
    property <length> block-hint-height: root.has-chat && root.active-chat.no-photo && root.active-chat.presence == "был(а) очень давно" && root.block-hint-dismissed != root.active-chat.id ? 74px : 0px;
    in-out property <int> block-hint-dismissed: -1;
    title: "Relay Desktop";
    no-frame: true;
    default-font-family: "Open Sans";
    default-font-size: 13px;
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 400px;
    min-height: 420px;
    background: Theme.canvas;

    in property <[ChatRow]> chats;
    in property <[MessageRow]> messages;
    in property <ChatRow> active-chat;
    in-out property <string> query;
    in-out property <string> draft;
    in-out property <int> active-folder: 0;
    in property <[FolderRow]> folders;
    in-out property <bool> photo-open: false;
    in-out property <image> photo-image;
    in-out property <string> photo-status;
    in-out property <string> photo-title;
    in-out property <int> photo-index;
    in-out property <int> photo-count;
    in-out property <float> photo-zoom: 1;
    in-out property <bool> has-chat: false;
    in-out property <bool> show-chat: false;
    in-out property <bool> settings-open: false;
    in-out property <int> settings-page: 0;
    in property <string> settings-error;

    in-out property <bool> auth-required: true;
    in-out property <int> auth-step: 0;
    in-out property <string> auth-qr-matrix: "";
    in-out property <string> auth-country: "Russian Federation";
    in-out property <string> auth-phone: "+7 ";
    in-out property <string> auth-code: "";
    in-out property <string> auth-password: "";
    in-out property <string> auth-password-hint: "";
    in-out property <string> auth-error: "";
    in-out property <bool> auth-busy: false;
    in-out property <string> auth-delivery: "";
    in-out property <bool> connected: false;
    in-out property <bool> message-busy: false;
    in-out property <bool> text-send-pending: false;
    in-out property <string> network-status: "";
    in-out property <int> selected-message: 0;
    in-out property <bool> selected-outgoing: false;
    in-out property <bool> selected-media: false;
    in-out property <string> selected-body: "";
    in-out property <int> reply-message: 0;
    in-out property <string> reply-author;
    in-out property <string> reply-body;
    in-out property <image> file-preview;
    in-out property <bool> has-file-preview;
    in-out property <string> file-preview-error;
    in-out property <int> edit-message-id: 0;
    in-out property <bool> file-open: false;
    in-out property <[AttachmentRow]> attachments;
    in-out property <string> attachment-caption;
    in-out property <bool> picker-busy;
    in-out property <int> attachment-generation;
    in-out property <int> attachment-pending;
    private property <int> attachment-chat-id: root.active-chat.id;
    changed attachment-chat-id => { root.cancel-attachments(); }
    public function cancel-attachments() {
        root.attachment-generation += 1; root.attachment-pending = 0;
        root.file-open = false; root.attachments = []; root.file-path = "";
        root.attachment-caption = ""; root.file-preview-error = "";
    }
    in-out property <bool> upload-busy;
    in-out property <bool> file-drag-hover;
    in-out property <bool> editor-menu-open;
    in-out property <bool> draft-has-formatting;
    in-out property <styled-text> draft-preview;
    in-out property <int> format-count;
    in-out property <bool> link-editor-open;
    in-out property <string> editor-link;
    in-out property <int> format-selection-start;
    in-out property <int> format-selection-end;
    in-out property <string> file-path: "";
    changed file-path => { root.has-file-preview = false; file-preview-timer.start(); file-preview-timer.restart(); }
    file-preview-timer := Timer { running: false; interval: 250ms; triggered => { self.stop(); root.preview-file(); } }
    in-out property <bool> chat-search-open: false;
    in-out property <string> chat-query: "";
    in-out property <bool> confirm-delete: false;
    in-out property <bool> forward-open: false;

    in-out property <string> user-name: "Relay Desktop";
    in-out property <string> user-phone: "+7 999 000-00-00";
    in-out property <string> user-username: "@relay_desktop";
    in-out property <string> user-initials: "R";

    callback auth-request-qr();
    callback auth-switch-to-phone();
    callback auth-switch-to-qr();
    callback auth-submit-phone();
    callback auth-submit-code();
    callback auth-submit-password();
    callback auth-open-demo();
    callback auth-logout();

    callback open-chat(int);
    callback pick-files();
    callback remove-attachment(int);
    callback draft-edited();
    callback format-editor(string, int, int);
    callback request-avatar(int);
    callback request-details(int);
    callback jump-reply(int);
    callback cancel-reply();
    callback network-events();
    callback preview-file();
    in-out property <bool> window-visible: true;
    out property <bool> conversation-visible: root.window-visible && root.has-chat && (!root.compact || root.show-chat);
    private property <int> details-generation: 0;
    changed history-scroll-y => { root.schedule-details(); }
    changed conversation-visible => { root.schedule-details(); }
    changed auth-required => { root.schedule-details(); if root.auth-required { root.cancel-attachments(); root.profile-open = false; } }
    // Slint restart() alone cannot initialize a stopped, never-started timer.
    // Start explicitly and debounce; stop after the single viewport scan.
    function schedule-details() { details-scan.start(); details-scan.restart(); }
    details-scan := Timer {
        running: false;
        interval: 80ms;
        triggered => { self.stop(); root.details-generation += 1; }
    }
    private property <int> jump-target;
    private property <int> jump-generation;
    property <length> reply-extra: root.reply-message > 0 || root.edit-message-id > 0 ? 50px : 0px;
    property <length> format-preview-height: root.draft-has-formatting ? 76px : 0px;
    property <length> composer-extra: root.reply-extra + root.format-preview-height;
    out property <length> composer-height: root.chat-can-write ? composer.content-height : 46px;
    callback select-folder(int);
    callback view-photo(int);
    callback step-photo(int);
    callback save-photo();
    callback join-channel();
    out property <bool> chat-can-write: root.active-chat.channel-access == 0 || root.active-chat.channel-access == 2;
    callback send-message();
    callback retry-message(int);
    callback send-file();
    callback message-action(string);
    callback load-older();
    callback search-chat();
    callback refresh-telegram();
    callback forward-message(int);
    callback open-first-result();
    callback query-edited();
    callback settings-changed();
    callback minimize-window();
    callback maximize-window();
    callback close-window();
    callback drag-window();
    callback suspend-ui();
    callback resume-ui();
    callback resize-window();

    property <bool> compact: root.width < 740px;
    property <length> rail-width: root.compact ? 0px : 72px;
    property <length> sidebar-width: root.compact ? root.width : 325px;
    property <length> chat-left: root.compact ? 0px : root.rail-width + root.sidebar-width + 1px;
    in-out property <bool> menu-open: false;
    in-out property <bool> emoji-open: false;
    in-out property <bool> chat-menu-open: false;
    private property <bool> message-menu: false;
    private property <length> menu-point-x;
    private property <length> menu-point-y;
    // Coordinates are relative to the chat pane, independent of sidebar/DPI.
    out property <length> chat-menu-x: chat-popup.x;
    out property <length> chat-menu-y: chat-popup.y;
    out property <length> chat-menu-width: chat-popup.width;
    out property <length> chat-menu-height: chat-popup.height;
    in-out property <length> history-scroll-y <=> history.viewport-y;
    out property <bool> history-at-bottom: history.viewport-y <= min(0px, history.view-height - history.content-height) + 2px;
    property <int> emoji-tab: 0;
    out property <float> menu-progress: menu-motion.value;
    out property <float> settings-progress: settings-motion.value;
    out property <float> compact-progress: compact-motion.value;
    out property <float> settings-page-progress: settings-page-motion.value;
    out property <float> layer-dim-progress: dim-motion.value;
    out property <float> auth-transition-progress: auth-screen.animation-progress;
    property <float> emoji-progress: emoji-motion.value;
    menu-motion := Motion { target: root.menu-open ? 1 : 0; curve: 1; }
    settings-motion := Motion { target: root.settings-open ? 1 : 0; }
    dim-motion := Motion {
        target: root.menu-open || root.settings-open ? 1 : 0;
        curve: root.menu-open || root.settings-open ? 1 : 0;
    }
    compact-motion := Motion {
        target: root.show-chat ? 1 : 0;
        curve: 1;
        duration: TelegramMotion.slide-duration;
    }
    settings-page-motion := Motion {
        target: root.settings-page;
        curve: 1;
        duration: TelegramMotion.slide-duration;
    }
    emoji-motion := Motion { target: root.emoji-open ? 1 : 0; curve: 1; duration: TelegramMotion.slide-duration; }

    forward-focus: keys;
    keys := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        enabled: !root.settings-open && !root.menu-open;
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "k" || event.text == "K") {
                root.show-chat = false;
                search.focus();
                return accept;
            }
            if event.text == Key.Escape {
                if root.chat-menu-open {
                    root.chat-menu-open = false;
                    return accept;
                }
                root.emoji-open = false;
                if root.query != "" {
                    root.query = "";
                    root.query-edited();
                } else {
                    root.has-chat = false;
                    root.show-chat = false;
                }
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: 0px;
            y: 26px;
            width: root.rail-width;
            height: root.height - 26px;
            visible: !root.compact;
            background: Theme.rail;

            Rectangle {
                x: 0px;
                y: 0px;
                width: 72px;
                height: 54px;
                background: rail-menu-hit.has-hover ? #ffffff0d : transparent;
                VectorIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: self.natural-width;
                    height: self.natural-height;
                    name: "menu";
                    tint: rail-menu-hit.has-hover ? #ffffff : Theme.rail-muted;
                }
                rail-menu-hit := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.menu-open = true; }
                }
            }

            ListView {
                y: 54px;
                width: parent.width;
                height: parent.height - 54px;
                viewport-width: self.width;
                viewport-height: root.folders.length * 64px;
                for folder[index] in root.folders : Rectangle {
                    property <bool> active: root.active-folder == folder.id;
                    property <int> unread: folder.unread;
                    x: 0px;
                    y: index * 64px;
                    width: 72px;
                    height: 64px;
                    background: active ? Theme.rail-active : folder-hit.has-hover ? #ffffff0a : transparent;
                    VectorIcon {
                        x: (parent.width - self.width) / 2;
                        y: 4px;
                        width: self.natural-width;
                        height: self.natural-height;
                        name: folder.id == 0 ? "chats" : "folder";
                        tint: active ? Theme.rail-accent : folder-hit.has-hover ? #99aec2 : Theme.rail-muted;
                    }
                    if unread > 0 : Rectangle {
                        x: parent.width - self.width - 4px;
                        y: 5px;
                        width: max(18px, badge-lbl.preferred-width + 10px);
                        height: 18px;
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            border-radius: self.height / 2;
                            background: active ? Theme.rail-accent : Theme.rail-muted;
                            border-color: active ? Theme.rail-active : Theme.rail;
                            border-width: 2px;
                        }
                        badge-lbl := Text {
                            width: parent.width;
                            height: parent.height;
                            text: unread > 99 ? "99+" : "\{unread}";
                            font-size: 10px;
                            font-weight: 600;
                            color: active ? Theme.rail-active : Theme.rail;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        x: 2px;
                        y: 41px;
                        width: 68px;
                        height: 16px;
                        text: folder.title;
                        color: active ? Theme.rail-accent : folder-hit.has-hover ? #99aec2 : Theme.rail-muted;
                        font-size: 11px;
                        font-weight: active ? 600 : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    folder-hit := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.select-folder(folder.id); }
                    }
                }
            }
        }

        Rectangle {
            x: root.rail-width - (root.compact ? TelegramMotion.slide-shift * root.compact-progress : 0px);
            y: 26px;
            width: root.sidebar-width;
            height: root.height - 26px;
            visible: !root.compact || root.compact-progress < 1;
            background: Theme.surface;
            if root.compact : IconButton {
                x: 7px;
                y: 7px;
                icon: "menu";
                label: "Main menu";
                clicked => { root.menu-open = true; }
            }
            search := Entry {
                x: root.compact ? 54px : 10px;
                y: 10px;
                width: parent.width - self.x - 10px;
                height: 34px;
                text <=> root.query;
                placeholder: "Search or @username";
                edited => { root.query-edited(); }
                accepted => { root.open-first-result(); }
            }
            if root.compact && root.folders.length > 1 : Flickable {
                x: 0px; y: 53px; width: parent.width; height: 36px;
                viewport-width: max(self.width, root.folders.length * 112px + 8px);
                viewport-height: self.height;
                for folder[index] in root.folders : ActionButton {
                    x: 4px + index * 112px; y: 2px; width: 108px; height: 32px;
                    text: folder.title;
                    selected: root.active-folder == folder.id;
                    clicked => { root.select-folder(folder.id); }
                }
            }
            chat-list := ListView {
                x: 0px;
                y: root.compact && root.folders.length > 1 ? 92px : 54px;
                width: parent.width;
                height: parent.height - self.y;
                viewport-width: self.width;
                for chat[index] in root.chats : ChatTile {
                    width: root.sidebar-width;
                    chat: chat;
                    row-index: index;
                    list-viewport-y: chat-list.viewport-y;
                    list-height: chat-list.height;
                    list-visible: !root.auth-required && (!root.compact || root.compact-progress < 1) && !root.forward-open;
                    selected: root.has-chat && chat.id == root.active-chat.id;
                    avatar-requested(id) => { root.request-avatar(id); }
                    opened => { root.chat-menu-open = false; root.open-chat(chat.id); }
                }
            }
            if root.chats.length == 0 : Text {
                y: 110px;
                width: parent.width;
                text: "No chats found";
                color: Theme.muted;
                font-size: 13px;
                horizontal-alignment: center;
            }
            if root.compact : Rectangle {
                background: #0000003c;
                opacity: root.compact-progress;
            }
        }

        if !root.compact : Rectangle {
            x: root.rail-width + root.sidebar-width;
            y: 26px;
            width: 1px;
            height: root.height - 26px;
            background: Theme.border;
        }

        Rectangle {
            x: root.compact ? root.width * (1 - root.compact-progress) : root.chat-left;
            y: 26px;
            width: root.compact ? root.width : root.width - root.chat-left;
            height: root.height - 26px;
            visible: !root.compact || root.compact-progress > 0;
            background: Theme.canvas;
            if root.compact && root.compact-progress > 0 && root.compact-progress < 1 : Rectangle {
                x: -12px; width: 12px; height: parent.height;
                background: @linear-gradient(90deg, #00000000, #00000040);
                opacity: root.compact-progress;
            }

            if !root.has-chat : Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: empty-label.preferred-width + 24px;
                height: 26px;
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    border-radius: self.height / 2;
                    background: Theme.service-bg;
                }
                empty-label := Text {
                    width: parent.width;
                    height: parent.height;
                    text: "Select a chat to start messaging";
                    color: Theme.service-fg;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.block-hint-height > 0px : Rectangle {
                y: 54px; width: parent.width; height: root.block-hint-height; background: Theme.surface;
                Text { x: 16px; y: 8px; width: parent.width - 62px; text: "Возможна блокировка"; color: Theme.accent; font-size: 13px; font-weight: 600; }
                Text { x: 16px; y: 29px; width: parent.width - 62px; text: "Нет фото, статус «был(а) очень давно». Это также бывает из-за приватности. Можно переключиться на другие чаты."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                IconButton { x: parent.width - 44px; y: 12px; icon: "close"; label: "Скрыть подсказку"; clicked => { root.block-hint-dismissed = root.active-chat.id; } }
            }
            header := Rectangle {
                x: 0px;
                y: 0px;
                width: history.width;
                height: 54px;
                visible: root.has-chat;
                background: Theme.surface;
                if root.compact : IconButton {
                    x: 6px;
                    y: 7px;
                    icon: "back";
                    label: "Back";
                    clicked => { root.show-chat = false; }
                }
                Text {
                    x: root.compact ? 54px : 18px;
                    y: root.active-chat.id == 3 ? 17px : 8px;
                    width: parent.width - self.x - 180px;
                    height: 20px;
                    text: root.active-chat.title;
                    color: Theme.ink;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.active-chat.id != 3 : Text {
                    x: root.compact ? 54px : 18px;
                    y: 29px;
                    width: parent.width - self.x - 180px;
                    height: 18px;
                    text: root.connected ? (root.active-chat.presence != "" ? root.active-chat.presence : "Telegram") : "Demo";
                    font-size: 13px;
                    color: root.active-chat.online ? Theme.accent : Theme.muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
                TouchArea { x: root.compact ? 54px : 12px; width: max(1px, parent.width - self.x - 180px); height: parent.height; mouse-cursor: pointer; clicked => { Theme.open-profile(root.active-chat.id == 3 ? "self" : "chat:" + root.active-chat.id); } }
                IconButton {
                    x: parent.width - 172px;
                    y: 7px;
                    icon: "search";
                    label: "Search";
                    clicked => { root.chat-search-open = !root.chat-search-open; }
                }
                IconButton {
                    x: parent.width - 130px;
                    y: 7px;
                    icon: "call";
                    label: "Calls require a Telegram connection";
                    enabled: false;
                }
                IconButton {
                    x: parent.width - 88px;
                    y: 7px;
                    icon: "panel";
                    label: "Emoji panel";
                    active: root.emoji-open;
                    clicked => { root.emoji-open = !root.emoji-open; }
                }
                IconButton {
                    x: parent.width - 46px;
                    y: 7px;
                    icon: "more";
                    label: "Chat menu";
                    clicked => {
                        root.selected-message = 0;
                        root.message-menu = false;
                        root.chat-menu-open = !root.chat-menu-open;
                    }
                }
                Rectangle {
                    x: 0px;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border;
                }
            }

            Rectangle {
                x: 0px;
                y: parent.height - root.composer-height;
                width: history.width;
                height: root.composer-height;
                visible: root.has-chat;
                background: Theme.surface;
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border;
                }
                IconButton {
                    x: 5px;
                    y: parent.height - 43px;
                    icon: "clip";
                    label: "Send a file";
                    visible: root.chat-can-write;
                    enabled: !root.picker-busy && !root.message-busy && root.edit-message-id == 0;
                    clicked => { root.pick-files(); }
                }
                composer := Composer {
                    x: 46px;
                    y: 0px;
                    width: parent.width - 174px;
                    height: parent.height;
                    text <=> root.draft;
                    placeholder-visible: !root.follow-sending;
                    visible: root.chat-can-write;
                    read-only: root.message-busy && !root.text-send-pending;
                    placeholder: root.edit-message-id > 0 ? "Edit message..." : root.reply-message > 0 ? "Reply..." : root.active-chat.channel-access == 2 ? "Опубликовать запись…" : "Write a message...";
                    accepted => { root.send-message(); }
                    edited => { root.draft-edited(); }
                    format-requested(kind, start, end) => { root.format-selection-start = start; root.format-selection-end = end; root.format-editor(kind, start, end); }
                }
                Rectangle {
                    x: parent.width - 126px; y: parent.height - 43px; width: 40px; height: 40px;
                    Text { width: parent.width; height: parent.height; text: "Aa"; font-size: 15px; font-weight: 600; color: root.draft-has-formatting ? Theme.accent : Theme.icon-fg; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { root.format-selection-start = composer.selection-start; root.format-selection-end = composer.selection-end; root.editor-menu-open = !root.editor-menu-open; } }
                }
                IconButton {
                    x: parent.width - 86px;
                    y: parent.height - 43px;
                    icon: "smile";
                    label: "Emoji";
                    visible: root.chat-can-write;
                    active: root.emoji-open;
                    clicked => { root.emoji-open = !root.emoji-open; }
                }
                IconButton {
                    x: parent.width - 44px;
                    y: parent.height - 43px;
                    icon: root.draft == "" ? "mic" : "send";
                    label: "Send message";
                    visible: root.chat-can-write;
                    active: root.draft != "";
                    enabled: root.draft != "" && !root.message-busy;
                    clicked => { root.send-message(); composer.focus(); }
                }
                if root.active-chat.channel-access == 1 : Text {
                    width: parent.width;
                    height: parent.height;
                    text: "Канал · только чтение";
                    color: Theme.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.active-chat.channel-access == 3 : ActionButton {
                    x: (parent.width - self.width) / 2;
                    y: 4px;
                    width: 180px;
                    height: 38px;
                    text: root.message-busy ? "Подключение…" : "Подписаться";
                    primary: true;
                    enabled: !root.message-busy;
                    clicked => { root.join-channel(); }
                }
            }

            history-mask := Rectangle {
                y: 54px + root.block-hint-height;
                width: parent.width - (root.compact ? 0px : 292px * root.emoji-progress);
                height: parent.height - self.y;
                clip: true;
                history := Flickable {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    property <length> view-height: parent.height - root.composer-height - root.composer-extra;
                    property <length> content-height: max(view-height, history-items.preferred-height);
                    property <length> flight-padding: root.follow-sending ? root.composer-height : 0px;
                    height: view-height + flight-padding;
                    interactive: !root.follow-sending;
                    visible: root.has-chat;
                    viewport-width: self.width;
                    viewport-height: content-height + flight-padding;
                    changed view-height => { root.schedule-details(); }
                    changed viewport-height => {
                        root.schedule-details();
                        if root.follow-sending || root.follow-incoming { root.scroll-to-bottom(); }
                    }
                    history-items := VerticalLayout {
                        width: history.width;
                        height: self.preferred-height;
                        y: max(0px, history.view-height - self.height);
                        padding: 0px;
                        spacing: 0px;
                        for message[index] in root.messages : Rectangle {
                            property <int> scanned-generation: -1;
                            property <bool> needs-details: message.id > 0
                                && ((message.is-photo && !message.has-preview && !message.preview-failed)
                                    || (message.reply-to > 0 && !message.reply-resolved));
                            property <string> detail-key: "\{message.id}/\{message.reply-to}/\{message.photo-key}";
                            changed detail-key => { self.scanned-generation = -1; }
                            changed needs-details => { if self.needs-details { self.scanned-generation = -1; } }
                            // Read row geometry after layout, never while the
                            // repeater is constructing its own layout delegates.
                            Timer {
                                running: parent.needs-details && root.conversation-visible && !root.auth-required
                                    && parent.scanned-generation != root.details-generation;
                                interval: 1ms;
                                triggered => {
                                    parent.scanned-generation = root.details-generation;
                                    if root.conversation-visible && !root.auth-required
                                        && history-items.y + parent.y + history.viewport-y < history.view-height + 150px
                                        && history-items.y + parent.y + history.viewport-y + parent.height > -150px {
                                        root.request-details(message.id);
                                    }
                                }
                            }
                            property <int> focus-token: root.jump-target == message.id ? root.jump-generation : 0;
                            changed focus-token => {
                                if self.focus-token > 0 { history.viewport-y = clamp(history.view-height / 2 - (history-items.y + self.y + self.height / 2), min(0px, history.view-height - history.content-height), 0px); }
                            }
                            sending := MessageSendMotion { token: message.send-token; }
                            receiving := MessageReceiveMotion { token: message.receive-token; }
                            property <bool> date-start: index == 0 || root.messages[index - 1].date != message.date;
                            property <bool> group-start: date-start || root.messages[index - 1].sender-key != message.sender-key || root.messages[index - 1].sender != message.sender || root.messages[index - 1].outgoing != message.outgoing || root.messages[index - 1].service;
                            property <bool> group-end: index + 1 == root.messages.length || root.messages[index + 1].sender-key != message.sender-key || root.messages[index + 1].sender != message.sender || root.messages[index + 1].outgoing != message.outgoing || root.messages[index + 1].date != message.date || root.messages[index + 1].service;
                            property <length> top-offset: date-start ? 40px : (group-start ? 6px : 0px);
                            property <length> bottom-pad: index + 1 == root.messages.length ? 8px : 2px;
                            property <length> edge-pad: group-end && Theme.design == 0 ? 10px : 16px;
                            property <length> final-height: (message.service ? 28px : bubble.height) + top-offset + bottom-pad;
                            property <length> send-hidden-height: final-height * (1 - sending.rise);
                            property <length> hidden-height: final-height * (1 - sending.rise * receiving.progress);
                            property <length> final-y: history-items.y + self.y + history.viewport-y + top-offset - hidden-height;
                            width: history.width;
                            height: final-height - hidden-height;
                            // A rectangular clip lets Skia skip entire offscreen
                            // subtrees, not just their individual drawing commands.
                            // Flying/revealing bubbles must still overflow the row.
                            clip: sending.progress >= 1 && receiving.progress >= 1;
                            if date-start : Rectangle {
                                opacity: sending.mix;
                                x: (parent.width - self.width) / 2;
                                y: 12px;
                                width: date-pill.preferred-width + 22px;
                                // Only the flying bubble enters the composer;
                                // date labels remain inside the history band.
                                height: min(24px, max(0px, history.view-height
                                    - (history-items.y + parent.y + history.viewport-y + 12px)));
                                clip: true;
                                Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: 24px;
                                    border-radius: self.height / 2;
                                    background: Theme.service-bg;
                                }
                                date-pill := Text {
                                    width: parent.width;
                                    height: 24px;
                                    text: message.date != "" ? message.date : "Demo";
                                    color: Theme.service-fg;
                                    font-size: 13px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            bubble := Bubble {
                                visible: !message.service;
                                property <length> final-x: self.outgoing ? parent.width - self.width - parent.edge-pad : parent.edge-pad;
                                // Entry's plain text starts at x=52px and y=14px
                                // in the composer. Account for the bubble's text padding.
                                x: final-x + (41px - final-x) * (1 - sending.horizontal);
                                y: parent.top-offset - parent.send-hidden-height
                                    + (history.view-height + 6px - parent.final-y - self.quote-height) * (1 - sending.rise);
                                focus-token: parent.focus-token;
                                sending-mix: sending.mix;
                                flight-running: sending.progress < 1 || receiving.progress < 1;
                                message: message;
                                is-read: root.active-chat.id == 3 || (message.id > 0 && message.id <= root.active-chat.read-outbox-max-id);
                                group-start: parent.group-start;
                                group-end: parent.group-end;
                                available-width: min(430px, history.width - 48px);
                                photo-requested => { root.view-photo(message.id); }
                                retry-requested => { root.retry-message(message.id); }
                                reply-requested => { root.jump-reply(message.id); }
                                selected(pointer-x, pointer-y) => {
                                    root.selected-message = message.id;
                                    root.selected-body = message.body;
                                    root.selected-outgoing = message.outgoing;
                                    root.selected-media = message.has-media;
                                    root.message-menu = true;
                                    root.menu-point-x = history-mask.x + history.x + history.viewport-x
                                        + history-items.x + parent.x + self.x + pointer-x;
                                    root.menu-point-y = history-mask.y + history.y + history.viewport-y
                                        + history-items.y + parent.y + self.y + pointer-y;
                                    root.chat-menu-open = true;
                                }
                            }
                            if message.service : Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: parent.top-offset;
                                width: min(history.width - 32px, service-label.preferred-width + 24px);
                                height: 26px;
                                Rectangle {
                                    width: parent.width; height: parent.height;
                                    border-radius: self.height / 2;
                                    background: Theme.service-bg;
                                }
                                service-label := Text {
                                    x: 12px; width: parent.width - 24px; height: parent.height;
                                    text: message.body; color: Theme.service-fg; font-size: 13px;
                                    font-weight: 600; overflow: elide;
                                    vertical-alignment: center; horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                visible: root.has-chat && history.content-height > history.view-height;
                x: history.width - 6px;
                y: history-mask.y + history.y + min(history.view-height - self.height, max(0px,
                    -history.viewport-y * (history.view-height - self.height)
                    / max(1px, history.content-height - history.view-height)));
                width: 4px;
                height: min(history.view-height, max(24px,
                    history.view-height * history.view-height / max(1px, history.content-height)));
                background: Theme.dark ? #7f84897a : #7f84894c;
                border-radius: 2px;
            }
            if root.reply-extra > 0px : Rectangle {
                x: 0px; y: parent.height - root.composer-height - root.composer-extra; width: history.width; height: root.reply-extra;
                background: Theme.surface;
                Rectangle { x: 48px; y: 5px; width: 3px; height: 40px; background: Theme.accent; }
                Text { x: 61px; y: 5px; width: parent.width - 110px; height: 18px; text: root.edit-message-id > 0 ? "Редактирование" : "Ответ: " + root.reply-author; color: Theme.accent; font-size: 13px; font-weight: 600; overflow: elide; }
                Text { x: 61px; y: 24px; width: parent.width - 110px; height: 19px; text: root.edit-message-id > 0 ? root.selected-body : root.reply-body; color: Theme.muted; font-size: 13px; overflow: elide; }
                TouchArea { x: 48px; y: 0px; width: parent.width - 96px; height: parent.height; mouse-cursor: pointer; clicked => { if root.reply-message > 0 { root.reveal-message(root.reply-message); } } }
                IconButton { x: parent.width - 44px; y: 5px; icon: "close"; label: "Отменить ответ"; clicked => { root.cancel-reply(); } }
            }
            if root.draft-has-formatting : Rectangle {
                x: 0px; y: parent.height - root.composer-height - root.format-preview-height; width: history.width; height: root.format-preview-height;
                background: Theme.surface;
                Text { x: 16px; y: 4px; text: "Предпросмотр форматирования"; font-size: 11px; color: Theme.accent; }
                Flickable { x: 16px; y: 24px; width: parent.width - 32px; height: 46px; viewport-width: self.width; viewport-height: preview.preferred-height;
                    preview := StyledText { width: parent.width; height: self.preferred-height; text: root.draft-preview; default-font-family: "Open Sans"; default-font-size: 13px; default-color: Theme.ink; link-color: Theme.accent; }
                }
            }

            if root.chat-search-open : Rectangle {
                x: 0px; y: 54px; width: history.width; height: 46px; background: Theme.surface;
                Entry { x: 8px; y: 3px; width: parent.width - 100px; height: 40px; text <=> root.chat-query; placeholder: "Search messages in this chat"; accepted => { root.search-chat(); } }
                ActionButton { x: parent.width - 84px; y: 5px; width: 76px; height: 36px; text: "Search"; clicked => { root.search-chat(); } }
            }

            Rectangle {
                width: parent.width;
                height: parent.height;
                visible: root.has-chat && (root.chat-menu-open || chat-popup.visible);
                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.chat-menu-open = false; }
                }
                chat-popup := PopupReveal {
                    shown: root.chat-menu-open;
                    // Decide the opening corner using full menu dimensions;
                    // anchor that corner throughout the reveal animation.
                    from-right: !root.message-menu || root.menu-point-x + self.content-width > history.width - 4px;
                    from-bottom: root.message-menu && root.menu-point-y + self.content-height > parent.height - 4px;
                    property <length> final-x: root.message-menu
                        ? clamp(root.menu-point-x - (self.from-right ? self.content-width : 0px), 4px, max(4px, history.width - self.content-width - 4px))
                        : max(4px, history.width - self.content-width - 8px);
                    property <length> final-y: root.message-menu
                        ? clamp(root.menu-point-y - (self.from-bottom ? self.content-height : 0px), 4px, max(4px, parent.height - self.content-height - 4px))
                        : 50px;
                    x: final-x + (self.from-right ? self.content-width - self.width : 0px);
                    y: final-y + (self.from-bottom ? self.content-height - self.height : 0px);
                    content-width: 218px;
                    content-height: menu-items.preferred-height + 8px;
                    fill: Theme.surface;
                    menu-items := VerticalLayout {
                        x: 1px; y: 4px; width: parent.width - 2px;
                        padding: 0px; spacing: 0px;
                        if root.selected-message > 0 && root.chat-can-write : MenuItem { text: "Ответить"; clicked => { root.chat-menu-open = false; root.message-action("reply"); } }
                        if root.selected-message > 0 : MenuItem { text: "Переслать"; clicked => { root.chat-menu-open = false; root.message-action("forward"); } }
                        if root.selected-message > 0 && root.selected-outgoing && !root.selected-media : MenuItem { text: "Изменить"; clicked => { root.chat-menu-open = false; root.message-action("edit"); } }
                        if root.selected-message > 0 && (root.active-chat.channel-access == 0 || (root.selected-outgoing && root.chat-can-write)) : MenuItem { text: "Удалить…"; clicked => { root.chat-menu-open = false; root.message-action("delete"); } }
                        if root.selected-message > 0 && root.selected-media : MenuItem { text: "Сохранить файл"; clicked => { root.chat-menu-open = false; root.message-action("download"); } }
                        if root.reply-message > 0 || root.edit-message-id > 0 : MenuItem { text: root.edit-message-id > 0 ? "Отменить редактирование" : "Отменить ответ"; clicked => { root.chat-menu-open = false; root.message-action("cancel"); } }
                        MenuItem { text: "Ранние сообщения"; enabled: root.connected; clicked => { root.chat-menu-open = false; root.load-older(); } }
                        MenuItem { text: "Обновить"; enabled: root.connected; clicked => { root.chat-menu-open = false; root.refresh-telegram(); } }
                        MenuItem { text: "Оформление"; clicked => { root.chat-menu-open = false; root.settings-page = 1; root.settings-open = true; } }
                    }
                }
            }

            Rectangle {
                x: parent.width - self.width * root.emoji-progress;
                y: 0px;
                width: root.compact ? parent.width : 292px;
                height: parent.height;
                visible: root.has-chat && root.emoji-progress > 0;
                background: Theme.surface;
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 1px;
                    height: parent.height;
                    background: Theme.border;
                }
                Rectangle {
                    x: 0px;
                    y: 53px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    x: 12px;
                    y: 9px;
                    width: parent.width - 24px;
                    height: 36px;
                    spacing: 4px;
                    for name[index] in ["Emoji", "Stickers", "GIFs"] : ActionButton {
                        text: name;
                        selected: root.emoji-tab == index;
                        clicked => { root.emoji-tab = index; }
                    }
                }
                if root.emoji-tab == 0 : Text {
                    x: 18px;
                    y: 66px;
                    text: "Smileys & People";
                    color: Theme.muted;
                    font-size: 12px;
                    font-weight: 600;
                }
                if root.emoji-tab == 0 : Rectangle {
                    x: 12px;
                    y: 90px;
                    width: parent.width - 24px;
                    height: 132px;
                    HorizontalLayout {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 40px;
                        spacing: 4px;
                        for emoji in ["😀", "😄", "😂", "🥰", "😍", "👍"] : ActionButton {
                            text: emoji;
                            clicked => { root.draft += emoji; composer.focus(); }
                        }
                    }
                    HorizontalLayout {
                        x: 0px;
                        y: 44px;
                        width: parent.width;
                        height: 40px;
                        spacing: 4px;
                        for emoji in ["❤️", "🔥", "🎉", "👋", "😊", "🤝"] : ActionButton {
                            text: emoji;
                            clicked => { root.draft += emoji; composer.focus(); }
                        }
                    }
                    HorizontalLayout {
                        x: 0px;
                        y: 88px;
                        width: parent.width;
                        height: 40px;
                        spacing: 4px;
                        for emoji in ["😎", "🤔", "🙌", "✨", "🚀", "✅"] : ActionButton {
                            text: emoji;
                            clicked => { root.draft += emoji; composer.focus(); }
                        }
                    }
                }
                if root.emoji-tab != 0 : Text {
                    x: 20px;
                    y: 120px;
                    width: parent.width - 40px;
                    text: "Available after Telegram connection";
                    wrap: word-wrap;
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    BoxOverlay {
        shown: root.profile-open && !root.auth-required; width: root.width; height: root.height;
        // Keep the native 26px caption interactive while this modal is open.
        TouchArea { y: 26px; width: parent.width; height: parent.height - 26px; clicked => { root.profile-open = false; } }
        profile-panel := ProfilePanel {
            x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
            width: min(TelegramProfile.desired-width, max(TelegramProfile.minimum-width, parent.width - 96px)); height: parent.height - 80px;
            shown: root.profile-open; profile-key: root.profile-key;
            is-user: root.profile-is-user; is-self: root.profile-is-self; is-bot: root.profile-is-bot;
            online: root.profile-online; birthday: root.profile-birthday;
            muted: root.profile-muted; action-busy: root.profile-action-busy || !root.profile-mute-ready;
            qr-matrix: root.profile-qr-matrix; profile-link: root.profile-link;
            name: root.profile-name; initials: root.profile-initials; presence: root.profile-presence;
            username: root.profile-username; phone: root.profile-phone; about: root.profile-about;
            photo: root.profile-photo; has-photo: root.profile-has-photo;
            gifts: root.profile-gifts; status: root.profile-status; gifts-status: root.profile-gifts-status;
            more: root.profile-next != ""; busy: root.profile-busy;
            action(kind) => { root.profile-action(kind); }
            closed => { root.profile-open = false; }
            view-photo => { root.profile-photo-requested(); }
            load-more => { root.more-gifts(); }
        }
    }
    if !root.auth-required && root.network-status != "" : Rectangle {
        x: root.chat-left + 8px; y: 36px;
        width: max(250px, root.width - root.chat-left - 16px); height: 44px;
        background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: 6px;
        Text { x: 8px; y: 4px; width: parent.width - 48px; height: parent.height - 8px; text: root.network-status; color: Theme.ink; wrap: word-wrap; font-size: 12px; }
        IconButton { x: parent.width - 40px; y: 2px; icon: "close"; label: "Dismiss"; clicked => { root.network-status = ""; } }
    }

    Rectangle {
        visible: root.large-editor-open && !root.auth-required;
        y: 26px; width: root.width; height: root.height - 26px; background: Theme.surface;
        Rectangle {
            x: 12px; y: 12px; width: 82px; height: 40px; border-radius: 22px; border-width: 1px; border-color: Theme.border;
            ActionButton { x: 0px; width: 40px; height: 40px; text: "↶"; enabled: root.editor-can-undo; clicked => { root.editor-history("undo"); large-composer.focus(); } }
            ActionButton { x: 40px; width: 40px; height: 40px; text: "↷"; enabled: root.editor-can-redo; clicked => { root.editor-history("redo"); large-composer.focus(); } }
        }
        Flickable {
            x: 106px; y: 12px; width: parent.width - 118px; height: 44px; viewport-width: 358px; viewport-height: 44px;
            Rectangle {
                width: 350px; height: 40px; border-radius: 22px; border-width: 1px; border-color: Theme.border;
                for label[index] in ["Aa", "B", "I", "U", "≡", "↗", "⌘", "☺"] : ActionButton {
                    x: 4px + index * 43px; width: 41px; height: 38px; text: label;
                    clicked => {
                        root.format-selection-start = large-composer.selection-start; root.format-selection-end = large-composer.selection-end;
                        if index == 0 { root.editor-menu-open = true; }
                        else if index == 5 { root.editor-link = "https://"; root.link-editor-open = true; }
                        else if index == 6 { root.pick-files(); }
                        else if index == 7 { root.draft += "🙂"; root.draft-edited(); large-composer.focus(); }
                        else { root.format-editor(index == 1 ? "bold" : index == 2 ? "italic" : index == 3 ? "underline" : "quote", root.format-selection-start, root.format-selection-end); large-composer.focus(); }
                    }
                }
            }
        }
        large-composer := Composer {
            x: 14px; y: 64px; width: parent.width - 28px; height: max(60px, parent.height - 144px - (root.draft-has-formatting ? 88px : 0px));
            text <=> root.draft; placeholder: "Напишите сообщение…"; expanded: true;
            read-only: root.message-busy && !root.text-send-pending;
            edited => { root.draft-edited(); }
            format-requested(kind, start, end) => { root.format-selection-start = start; root.format-selection-end = end; root.format-editor(kind, start, end); }
        }
        if root.draft-has-formatting : Rectangle {
            x: 20px; y: parent.height - 158px; width: parent.width - 40px; height: 84px; border-width: 1px; border-color: Theme.border; border-radius: 8px;
            Flickable { x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px; viewport-width: self.width; viewport-height: formatted.preferred-height;
                formatted := StyledText { width: parent.width; height: self.preferred-height; text: root.draft-preview; default-font-size: 13px; default-color: Theme.ink; link-color: Theme.accent; }
            }
        }
        Text { x: 20px; y: parent.height - 46px; text: "Редактор сообщения"; color: Theme.muted; font-size: 12px; }
        IconButton { x: parent.width - 104px; y: parent.height - 54px; icon: "close"; label: "Отменить изменения"; clicked => { root.editor-history("cancel"); root.large-editor-open = false; root.large-editor-dismissed = true; composer.focus(); } }
        Rectangle { x: parent.width - 52px; y: parent.height - 54px; width: 40px; height: 40px; border-radius: 20px; background: Theme.accent;
            Text { width: parent.width; height: parent.height; text: "✓"; color: white; font-size: 25px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { root.large-editor-open = false; root.large-editor-dismissed = true; composer.focus(); } }
        }
    }
    if root.file-drag-hover && root.has-chat && !root.auth-required : Rectangle {
        x: root.chat-left + 8px; y: 88px; width: root.width - self.x - 8px; height: root.height - 150px;
        background: Theme.surface.transparentize(0.08); border-width: 2px; border-color: Theme.accent; border-radius: 12px;
        Text { width: parent.width; height: parent.height; text: "Перетащите файлы сюда\nПеред отправкой появится предпросмотр"; color: Theme.accent; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.editor-menu-open : Rectangle {
        width: root.width; height: root.height;
        TouchArea { width: parent.width; height: parent.height; clicked => { root.editor-menu-open = false; } }
        Rectangle {
            x: max(8px, root.width - 244px); y: max(30px, root.height - root.composer-height - self.height - 6px);
            width: 232px; height: min(412px, root.height - 64px); background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.border;
            Flickable {
                width: parent.width; height: parent.height;
                viewport-width: self.width; viewport-height: 412px;
                for entry[index] in ["Вставить · Ctrl+V", "Копировать · Ctrl+C", "Вырезать · Ctrl+X", "Выделить всё · Ctrl+A", "Жирный · Ctrl+B", "Курсив · Ctrl+I", "Подчёркнутый · Ctrl+U", "Зачёркнутый", "Моноширинный · Ctrl+M", "Добавить ссылку", "Снять форматирование", "Развернуть редактор"] : MenuItem {
                    x: 0px; y: 2px + index * 34px; width: parent.width; text: entry;
                    clicked => {
                        root.editor-menu-open = false;
                        if index < 4 { root.composer-edit-action(index == 0 ? "paste" : index == 1 ? "copy" : index == 2 ? "cut" : "select-all"); }
                        else if index == 9 { root.editor-link = "https://"; root.link-editor-open = true; }
                        else if index == 11 { root.expand-composer(); }
                        else { root.format-editor(index == 4 ? "bold" : index == 5 ? "italic" : index == 6 ? "underline" : index == 7 ? "strike" : index == 8 ? "code" : "clear", root.format-selection-start, root.format-selection-end); }
                    }
                }
            }
        }
    }
    BoxOverlay {
        shown: root.link-editor-open; width: root.width; height: root.height;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; width: min(400px, parent.width - 24px); height: 170px; background: Theme.surface; border-radius: 8px;
            Text { x: 18px; y: 18px; text: "Ссылка для выделенного текста"; color: Theme.ink; font-size: 15px; }
            Entry { x: 18px; y: 54px; width: parent.width - 36px; height: 40px; text <=> root.editor-link; placeholder: "https://"; }
            ActionButton { x: 18px; y: 116px; text: "Отмена"; clicked => { root.link-editor-open = false; } }
            ActionButton { x: parent.width - 130px; y: 116px; text: "Применить"; primary: true; clicked => { root.format-editor("link", root.format-selection-start, root.format-selection-end); root.link-editor-open = false; } }
        }
    }
    BoxOverlay {
        shown: root.forward-open && !root.auth-required;
        width: root.width; height: root.height;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(420px, parent.width - 24px); height: min(500px, parent.height - 40px); background: Theme.surface;
            Text { x: 18px; y: 16px; text: "Forward to…"; color: Theme.ink; font-size: 17px; }
            IconButton { x: parent.width - 44px; y: 8px; icon: "close"; label: "Cancel"; clicked => { root.forward-open = false; } }
            forward-list := ListView {
                x: 0px; y: 54px; width: parent.width; height: parent.height - 54px; viewport-width: self.width;
                for chat[index] in root.chats : ChatTile {
                    width: parent.width;
                    chat: chat;
                    row-index: index;
                    list-viewport-y: forward-list.viewport-y;
                    list-height: forward-list.height;
                    list-visible: root.forward-open && !root.auth-required;
                    selected: false;
                    avatar-requested(id) => { root.request-avatar(id); }
                    opened => { root.forward-message(chat.id); }
                }
            }
        }
    }

    BoxOverlay {
        shown: root.file-open && !root.auth-required;
        width: root.width; height: root.height;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(480px, parent.width - 24px); height: min(parent.height - 40px, root.has-file-preview ? 540px : 330px);
            background: Theme.surface; border-radius: 8px;
            Text { x: 18px; y: 18px; text: "Отправить вложение"; color: Theme.ink; font-size: 17px; }
            Text { x: 18px; y: 54px; width: parent.width - 140px; text: root.file-preview-error != "" ? root.file-preview-error : root.attachment-pending > 0 ? "Проверка файлов…" : "Выбрано файлов: " + root.attachments.length; color: Theme.muted; wrap: word-wrap; font-size: 13px; }
            ActionButton { x: parent.width - 116px; y: 42px; width: 98px; text: "Добавить"; enabled: !root.picker-busy; clicked => { root.pick-files(); } }
            ListView { x: 18px; y: 88px; width: parent.width - 36px; height: 110px; viewport-width: self.width;
                for file[index] in root.attachments : Rectangle {
                    width: parent.width; height: 52px;
                    Text { x: 0px; y: 4px; width: parent.width - 44px; text: file.name; color: Theme.ink; font-size: 13px; overflow: elide; }
                    Text { x: 0px; y: 26px; text: file.size; color: Theme.muted; font-size: 12px; }
                    IconButton { x: parent.width - 40px; y: 4px; icon: "close"; label: "Убрать файл"; clicked => { root.remove-attachment(index); } }
                }
            }
            if root.has-file-preview : Image { x: 18px; y: 204px; width: parent.width - 36px; height: max(0px, parent.height - 326px); source: root.file-preview; image-fit: contain; }
            Entry { x: 18px; y: parent.height - 114px; width: parent.width - 36px; height: 40px; text <=> root.attachment-caption; placeholder: "Подпись"; }
            HorizontalLayout {
                x: 18px; y: parent.height - 56px; width: parent.width - 36px; height: 36px; spacing: 12px;
                ActionButton { text: "Отмена"; clicked => { root.cancel-attachments(); } }
                ActionButton { text: "Отправить"; primary: true; enabled: root.attachments.length > 0 && root.attachment-pending == 0 && !root.message-busy; clicked => { root.send-file(); } }
            }
        }
    }

    BoxOverlay {
        shown: root.confirm-delete && !root.auth-required;
        width: root.width; height: root.height;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - 160px) / 2;
            width: min(420px, parent.width - 24px); height: 160px; background: Theme.surface; border-radius: 8px;
            Text { x: 18px; y: 20px; width: parent.width - 36px; text: "Delete this message for everyone? This cannot be undone."; color: Theme.ink; wrap: word-wrap; }
            HorizontalLayout {
                x: 18px; y: 106px; width: parent.width - 36px; height: 36px; spacing: 12px;
                ActionButton { text: "Cancel"; clicked => { root.confirm-delete = false; } }
                ActionButton { text: "Delete"; clicked => { root.message-action("confirm-delete"); root.confirm-delete = false; } }
            }
        }
    }

    Rectangle {
        visible: root.photo-open && !root.auth-required;
        x: 0px; y: 26px; width: root.width; height: root.height - 26px;
        background: #101318f5;
        TouchArea { width: parent.width; height: parent.height; }
        photo-keys := FocusScope {
            width: parent.width; height: parent.height;
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-photo(); return accept; }
                if event.text == Key.LeftArrow { root.step-photo(-1); return accept; }
                if event.text == Key.RightArrow { root.step-photo(1); return accept; }
                return reject;
            }
        }
        photo-viewport := Flickable {
            visible: root.photo-status == "";
            x: 52px; y: 50px; width: parent.width - 104px; height: parent.height - 112px;
            viewport-width: self.width * root.photo-zoom;
            viewport-height: self.height * root.photo-zoom;
            Image {
                width: photo-viewport.viewport-width;
                height: photo-viewport.viewport-height;
                source: root.photo-image;
                image-fit: contain;
            }
        }
        Text {
            x: 18px; y: 8px; width: parent.width - 136px; height: 34px;
            text: root.photo-title + "  ·  " + "\{root.photo-index} / \{root.photo-count}";
            color: #ffffff; font-size: 15px; overflow: elide; vertical-alignment: center;
        }
        ActionButton {
            x: 8px; y: (parent.height - self.height) / 2; width: 40px; height: 44px;
            text: "‹"; enabled: root.photo-index > 1;
            clicked => { root.step-photo(-1); }
        }
        ActionButton {
            x: parent.width - 48px; y: (parent.height - self.height) / 2; width: 40px; height: 44px;
            text: "›"; enabled: root.photo-index < root.photo-count;
            clicked => { root.step-photo(1); }
        }
        HorizontalLayout {
            x: (parent.width - self.width) / 2; y: parent.height - 52px; width: 288px; height: 38px; spacing: 6px;
            ActionButton { text: "−"; enabled: root.photo-zoom > 1; clicked => { root.zoom-photo(max(1, root.photo-zoom - 0.5)); } }
            ActionButton { text: "По размеру"; clicked => { root.zoom-photo(1); } }
            ActionButton { text: "+"; enabled: root.photo-status == "" && root.photo-zoom < 4; clicked => { root.zoom-photo(min(4, root.photo-zoom + 0.5)); } }
            ActionButton { text: "Сохранить"; enabled: root.photo-status == ""; clicked => { root.save-photo(); } }
        }
        if root.photo-status != "" : Text {
            x: 24px; y: 48px; width: parent.width - 48px; height: parent.height - 68px;
            text: root.photo-status; color: #ffffff; wrap: word-wrap;
            horizontal-alignment: center; vertical-alignment: center;
        }
        ActionButton {
            x: parent.width - 104px; y: 8px; width: 92px; height: 34px;
            text: "Закрыть";
            clicked => { root.close-photo(); }
        }
    }

    auth-screen := AuthScreen {
        visible: root.auth-required;
        x: 0px;
        y: 26px;
        width: root.width;
        height: root.height - 26px;
        step <=> root.auth-step;
        qr-matrix: root.auth-qr-matrix;
        country <=> root.auth-country;
        phone <=> root.auth-phone;
        code <=> root.auth-code;
        password <=> root.auth-password;
        password-hint: root.auth-password-hint;
        error-text: root.auth-error;
        busy: root.auth-busy;
        delivery: root.auth-delivery;
        request-qr => { root.auth-request-qr(); }
        switch-to-phone => { root.auth-switch-to-phone(); }
        switch-to-qr => { root.auth-switch-to-qr(); }
        submit-phone => { root.auth-submit-phone(); }
        submit-code => { root.auth-submit-code(); }
        submit-password => { root.auth-submit-password(); }
        open-demo => { root.auth-open-demo(); }
        open-settings => {
            root.settings-page = 1;
            root.settings-open = true;
        }
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: 26px;
        background: Theme.titlebar;
        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width - 108px;
            height: parent.height;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.drag-window();
                }
            }
            double-clicked => { root.maximize-window(); }
        }
        for symbol[index] in ["−", "□", "×"] : Rectangle {
            x: parent.width - 108px + index * 36px;
            y: 0px;
            width: 36px;
            height: 26px;
            background: title-hit.has-hover ? (index == 2 ? #e81123 : Theme.titlebar-hover) : transparent;
            VectorIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: self.natural-width;
                height: self.natural-height;
                name: index == 0 ? "minimize" : index == 1 ? "maximize" : "window-close";
                tint: title-hit.has-hover ? (index == 2 ? #ffffff : Theme.titlebar-hover-fg) : Theme.titlebar-fg;
            }
            title-hit := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    if index == 0 { root.minimize-window(); }
                    else if index == 1 { root.maximize-window(); }
                    else { root.close-window(); }
                }
            }
        }
    }

    Rectangle {
        x: 0px; y: 26px; width: root.width; height: root.height - 26px;
        visible: root.layer-dim-progress > 0;
        background: rgba(0, 0, 0, (127 / 255) * root.layer-dim-progress);
    }
    Rectangle {
        x: 0px;
        visible: root.menu-progress > 0;
        y: 26px;
        width: root.width;
        height: root.height - 26px;
        background: transparent;
        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.menu-open = false; }
        }
        Rectangle {
            x: -274px * (1 - root.menu-progress);
            y: 0px;
            width: 274px;
            height: parent.height;
            background: Theme.surface;
            TouchArea { width: parent.width; height: parent.height; }
            Avatar {
                x: 22px;
                y: 20px;
                width: 48px;
                height: 48px;
                initials: root.user-initials;
                photo: root.user-avatar;
                has-photo: root.user-has-avatar;
                tint-top: #72d5fd;
                tint: #2a9ef1;
                TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { root.menu-open = false; Theme.open-profile("self"); } }
            }
            Text {
                x: 24px;
                y: 84px;
                width: 226px;
                text: root.user-name;
                color: Theme.ink;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                x: 24px;
                y: 105px;
                width: 226px;
                text: root.user-phone != "" ? root.user-phone : "Set Emoji Status";
                color: Theme.accent;
                font-size: 12px;
                overflow: elide;
            }
            Rectangle {
                x: 0px;
                y: 136px;
                width: parent.width;
                height: 1px;
                background: Theme.border;
            }
            for name[index] in ["My Profile", "New Group", "New Channel", "Contacts", "Calls",
                "Saved Messages", "Settings", "Night Mode"] : Rectangle {
                x: 0px;
                y: 144px + index * 40px + (index > 0 ? 8px : 0px);
                width: parent.width;
                height: 40px;
                background: menu-hit.has-hover ? Theme.hover : transparent;
                RippleSurface {
                    pressed: menu-hit.pressed;
                    press-x: menu-hit.mouse-x;
                    press-y: menu-hit.mouse-y;
                    ink: Theme.ripple;
                }
                if index == 1 : Rectangle {
                    x: 0px;
                    y: -4px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border;
                }
                VectorIcon {
                    x: 21px;
                    y: (parent.height - self.height) / 2;
                    width: self.natural-width;
                    height: self.natural-height;
                    name: index == 0 ? "profile"
                        : index == 1 ? "groups_create"
                        : index == 2 ? "channel"
                        : index == 3 ? "personal"
                        : index == 4 ? "phone"
                        : index == 5 ? "saved"
                        : index == 6 ? "settings" : "moon";
                    tint: Theme.menu-icon-fg;
                }
                Text {
                    x: 64px;
                    width: parent.width - 74px;
                    height: parent.height;
                    text: name;
                    color: Theme.ink;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                if index == 7 : Rectangle {
                    x: 216px;
                    y: 12px;
                    width: 34px;
                    height: 16px;
                    toggle-motion := Motion { target: Theme.dark ? 1 : 0; duration: TelegramMotion.toggle-duration; }
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        border-radius: self.height / 2;
                        background: Theme.dark ? Theme.accent : Theme.muted;
                        animate background { duration: TelegramMotion.toggle-duration; easing: linear; }
                    }
                    Rectangle {
                        x: 2px + 16px * toggle-motion.value;
                        y: 1px;
                        width: 14px;
                        height: 14px;
                        border-radius: self.height / 2;
                        background: Theme.surface;
                    }
                }
                menu-hit := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: index >= 5 || index == 0 ? MouseCursor.pointer : MouseCursor.default;
                    enabled: root.menu-open && (index >= 5 || index == 0);
                    clicked => {
                        if index == 7 {
                            Theme.dark = !Theme.dark;
                            root.settings-changed();
                        } else {
                            root.menu-open = false;
                            if index == 5 { root.open-chat(3); }
                            else {
                                root.settings-page = 0;
                                root.settings-open = true;
                            }
                        }
                    }
                }
            }
            Text {
                x: 24px;
                y: parent.height - 52px;
                text: "Telegram Desktop\nVersion 7.4.1 x64 — Relay UI";
                font-size: 12px;
                color: Theme.muted;
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 26px;
        visible: root.settings-progress > 0;
        width: root.width;
        height: root.height - 26px;
        background: transparent;
        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.settings-open = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(392px, parent.width - 24px);
            height: min(620px, parent.height - 32px);
            background: transparent;
            opacity: root.settings-progress;
            clip: true;
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                border-radius: Theme.material ? 24px : 8px;
                background: Theme.surface;
            }
            TouchArea { width: parent.width; height: parent.height; }
            Text {
                x: 22px - TelegramMotion.slide-shift * root.settings-page-progress;
                y: 16px;
                text: "Settings";
                visible: root.settings-page-progress < 1;
                font-size: 16px;
                font-weight: 600;
                color: Theme.ink;
            }
            Text {
                x: 56px + parent.width * (1 - root.settings-page-progress);
                y: 16px;
                text: "Chat Settings";
                visible: root.settings-page-progress > 0;
                font-size: 16px;
                font-weight: 600;
                color: Theme.ink;
            }
            IconButton {
                x: parent.width - 46px;
                y: 7px;
                icon: "close";
                label: "Close settings";
                clicked => { root.settings-open = false; }
            }
            IconButton {
                x: 8px + parent.width * (1 - root.settings-page-progress);
                y: 7px;
                visible: root.settings-page-progress > 0;
                icon: "back";
                label: "Back to settings";
                clicked => { root.settings-page = 0; }
            }
            SettingsHome {
                x: -TelegramMotion.slide-shift * root.settings-page-progress;
                y: 54px;
                visible: root.settings-page-progress < 1;
                width: parent.width;
                height: parent.height - 54px;
                user-name: root.user-name;
                user-phone: root.user-phone;
                user-username: root.user-username;
                user-initials: root.user-initials;
                user-avatar: root.user-avatar;
                user-has-avatar: root.user-has-avatar;
                profile-requested => { Theme.open-profile("self"); }
                gifts-changed => { root.settings-changed(); }
                appearance-requested => { root.settings-page = 1; }
                logout-requested => {
                    root.settings-open = false;
                    root.auth-logout();
                }
            }
            Rectangle {
                y: 54px; width: parent.width; height: parent.height - 54px;
                background: #0000003c;
                opacity: root.settings-page-progress;
                visible: root.settings-page-progress > 0 && root.settings-page-progress < 1;
            }
            Rectangle {
                x: parent.width * (1 - root.settings-page-progress);
                y: 54px;
                width: parent.width;
                height: parent.height - 54px;
                visible: root.settings-page-progress > 0;
                background: Theme.surface;
                Rectangle {
                    x: -12px; width: 12px; height: parent.height;
                    background: @linear-gradient(90deg, #00000000, #00000040);
                    opacity: root.settings-page-progress;
                }
                Text {
                    x: 22px;
                    y: 14px;
                    text: "Color theme";
                    color: Theme.accent;
                    font-size: 13px;
                    font-weight: 600;
                }
                HorizontalLayout {
                    x: 22px;
                    y: 44px;
                    width: parent.width - 44px;
                    height: 86px;
                    spacing: 10px;
                    for name[index] in ["Telegram", "Material You", "WinUI 3"] : Rectangle {
                        background: index == 1 ? (Theme.dark ? #292632 : #ece6f5) : Theme.canvas;
                        border-radius: index == 1 ? 14px : 6px;
                        border-width: Theme.design == index ? 2px : 1px;
                        border-color: Theme.design == index ? Theme.accent : Theme.border;
                        Rectangle {
                            x: 10px; y: 12px;
                            width: parent.width * 0.57; height: 12px;
                            border-radius: index == 1 ? 6px : 4px;
                            background: Theme.incoming;
                        }
                        Rectangle {
                            x: parent.width * 0.36; y: 31px;
                            width: parent.width * 0.53; height: 12px;
                            border-radius: index == 1 ? 6px : 4px;
                            background: Theme.outgoing;
                        }
                        Text {
                            y: 58px;
                            width: parent.width;
                            height: 20px;
                            text: name;
                            color: Theme.design == index ? Theme.accent : Theme.ink;
                            font-size: 11px;
                            font-weight: Theme.design == index ? 600 : 400;
                            horizontal-alignment: center;
                        }
                        TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { Theme.design = index; root.settings-changed(); }
                        }
                    }
                }
                Text {
                    x: 22px;
                    y: 158px;
                    text: "Color mode";
                    font-size: 13px;
                    color: Theme.ink;
                }
                ActionButton {
                    x: parent.width - 108px;
                    y: 148px;
                    width: 86px;
                    height: 36px;
                    text: Theme.dark ? "Night" : "Day";
                    selected: true;
                    clicked => { Theme.dark = !Theme.dark; root.settings-changed(); }
                }
                HorizontalLayout {
                    x: 22px;
                    y: 204px;
                    width: parent.width - 44px;
                    height: 36px;
                    spacing: 8px;
                    visible: Theme.material;
                    for swatch[index] in [#4266a7, #38745b, #76549a] : ActionButton {
                        text: index == 0 ? "Blue" : index == 1 ? "Green" : "Purple";
                        selected: Theme.seed == swatch;
                        clicked => { Theme.seed = swatch; root.settings-changed(); }
                    }
                }
                Text {
                    x: 22px;
                    y: 266px;
                    width: parent.width - 44px;
                    text: root.settings-error != "" ? root.settings-error
                        : (root.connected ? "Connected to Telegram" : "Demo mode");
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
            if !root.settings-open || (root.settings-page-progress > 0 && root.settings-page-progress < 1) : TouchArea {
                width: parent.width; height: parent.height;
            }
        }
    }

    TouchArea {
        x: root.width - 8px;
        y: root.height - 8px;
        width: 8px;
        height: 8px;
        mouse-cursor: MouseCursor.se-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.resize-window();
            }
        }
    }

    public function composer-menu() {
        root.format-selection-start = root.large-editor-open ? large-composer.selection-start : composer.selection-start;
        root.format-selection-end = root.large-editor-open ? large-composer.selection-end : composer.selection-end;
        root.editor-menu-open = true;
    }
    public function composer-edit-action(action: string) {
        if root.large-editor-open { large-composer.edit-action(action); } else { composer.edit-action(action); }
    }
    public function focus-composer() { if root.large-editor-open { large-composer.focus(); } else { composer.focus(); } }
    private property <bool> follow-sending: false;
    private property <bool> follow-incoming: false;
    receive-timer := Timer {
        running: root.follow-incoming;
        interval: TelegramMotion.receive-duration;
        triggered => {
            // Timers run before changed-property handlers. Include the final
            // reveal frame before releasing the bottom-follow behavior.
            root.scroll-to-bottom();
            root.follow-incoming = false;
        }
    }
    public function animate-received-message() {
        root.follow-incoming = true;
        receive-timer.restart();
    }
    follow-timer := Timer {
        running: root.follow-sending;
        interval: TelegramMotion.send-duration;
        triggered => { root.follow-sending = false; }
    }
    public function animate-sent-message() {
        root.follow-sending = true;
        follow-timer.restart();
    }
    public function focus-photo() { root.zoom-photo(1); }
    function zoom-photo(factor: float) {
        root.photo-zoom = factor;
        photo-viewport.viewport-x = (photo-viewport.width - photo-viewport.viewport-width) / 2;
        photo-viewport.viewport-y = (photo-viewport.height - photo-viewport.viewport-height) / 2;
        photo-keys.focus();
    }
    function close-photo() {
        root.photo-open = false;
        root.photo-status = "";
        if root.photo-from-profile {
            root.photo-from-profile = false; root.profile-open = true; profile-panel.focus();
        } else { composer.focus(); }
    }
    public function scroll-to-bottom() {
        history.viewport-y = min(0px, history.view-height - history.content-height);
    }
    public function reveal-message(id: int) { root.jump-target = id; root.jump-generation += 1; root.chat-menu-open = false; }
}
