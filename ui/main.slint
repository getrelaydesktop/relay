import { VectorIcon } from "icons/vector-icons.slint";
import { TelegramMotion, Motion, PopupReveal, BoxOverlay, RippleSurface } from "motion.slint";
import { ListView } from "list-view.slint";
import { AuthScreen } from "auth.slint";
import { SettingsHome } from "settings-home.slint";
import { Theme, ActionButton, Entry, IconButton, MenuItem, AvatarFill, BubbleShape } from "theme.slint";
import "fonts/OpenSans-Regular.ttf";
import "fonts/OpenSans-SemiBold.ttf";
export { Theme } from "theme.slint";
export { TelegramMotion } from "motion.slint";

export struct ChatRow {
    id: int,
    title: string,
    initials: string,
    accent: color,
    accent-top: color,
    preview: string,
    time: string,
    unread: int,
    outgoing: bool,
    last-message-id: int,
    read-outbox-max-id: int,
    folder: int,
    channel-access: int,
    avatar: image,
    has-avatar: bool,
}

export struct MessageRow {
    id: int,
    date: string,
    has-media: bool,
    is-photo: bool,
    body: string,
    time: string,
    outgoing: bool,
    channel-post: bool,
    service: bool,
}

export struct FolderRow {
    id: int,
    title: string,
    unread: int,
}

component Avatar inherits Rectangle {
    in property <string> initials;
    in property <color> tint;
    in property <color> tint-top;
    in property <bool> saved: false;
    in property <image> photo;
    in property <bool> has-photo: false;
    width: 46px;
    height: 46px;
    border-radius: min(self.width, self.height) / 2;
    clip: true;
    if root.has-photo && !root.saved : Image {
        width: parent.width;
        height: parent.height;
        source: root.photo;
        image-fit: cover;
        image-rendering: smooth;
    }
    if !root.has-photo || root.saved : AvatarFill {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        top: root.tint-top;
        bottom: root.tint;
    }
    if root.saved : VectorIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: parent.width * 24 / 46;
        height: parent.height * 24 / 46;
        name: "saved";
        tint: #ffffff;
    }
    if !root.saved && !root.has-photo : Text {
        width: parent.width;
        height: parent.height;
        text: root.initials;
        color: #ffffff;
        font-size: 18px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ChatTile inherits Rectangle {
    in property <ChatRow> chat;
    in property <bool> selected;
    in property <int> row-index: 0;
    in property <length> list-viewport-y: 0px;
    in property <length> list-height: 0px;
    in property <bool> list-visible: true;
    callback avatar-requested(int);
    callback opened();
    height: 62px;
    property <bool> avatar-in-viewport: root.list-visible
        && root.row-index * 62px + root.list-viewport-y < root.list-height
        && (root.row-index + 1) * 62px + root.list-viewport-y > 0px;
    property <int> avatar-request-key: root.avatar-in-viewport && !root.chat.has-avatar && root.chat.id != 3
        ? root.chat.id : 0;
    init => {
        if (root.avatar-request-key != 0) {
            root.avatar-requested(root.avatar-request-key);
        }
    }
    changed avatar-request-key => {
        if (root.avatar-request-key != 0) {
            root.avatar-requested(root.avatar-request-key);
        }
    }
    property <bool> last-message-read: chat.id == 3 || chat.last-message-id <= chat.read-outbox-max-id;
    clip: true;
    property <string> unread-label: chat.unread > 999 ? "999+" : "\{chat.unread}";
    background: transparent;
    accessible-role: button;
    accessible-label: chat.title;
    accessible-action-default => { root.opened(); }
    Rectangle {
        x: Theme.design == 0 ? 0px : 4px;
        y: Theme.design == 0 ? 0px : 3px;
        width: parent.width - (Theme.design == 0 ? 0px : 8px);
        height: parent.height - (Theme.design == 0 ? 0px : 6px);
        border-radius: Theme.design == 0 ? 0px : 10px;
        background: root.selected ? Theme.selected : pointer.has-hover ? Theme.hover : transparent;
    }
    RippleSurface {
        x: Theme.design == 0 ? 0px : 4px;
        y: Theme.design == 0 ? 0px : 3px;
        width: parent.width - (Theme.design == 0 ? 0px : 8px);
        height: parent.height - (Theme.design == 0 ? 0px : 6px);
        border-radius: Theme.design == 0 ? 0px : 10px;
        pressed: pointer.pressed;
        press-x: pointer.mouse-x - self.x;
        press-y: pointer.mouse-y - self.y;
        ink: root.selected ? Theme.selected-dialog-ripple : Theme.dialog-ripple;
    }
    Avatar {
        x: 10px;
        y: 8px;
        visible: root.avatar-in-viewport;
        initials: root.chat.initials;
        tint: root.chat.accent;
        tint-top: root.chat.accent-top;
        saved: root.chat.id == 3;
        photo: root.chat.avatar;
        has-photo: root.chat.has-avatar;
    }
    Text {
        x: 68px;
        y: 10px;
        width: parent.width - 138px;
        height: 20px;
        text: root.chat.title;
        color: root.selected ? Theme.selected-ink : Theme.ink;
        font-size: 13px;
        font-weight: 600;
        overflow: elide;
        vertical-alignment: center;
    }
    if root.chat.outgoing && root.chat.channel-access == 0 && root.last-message-read : VectorIcon {
        x: parent.width - 31px - time-label.preferred-width;
        y: 14px;
        width: self.natural-width;
        height: self.natural-height;
        name: "read";
        tint: root.selected ? Theme.selected-ink : Theme.outgoing-check;
    }
    if root.chat.outgoing && root.chat.channel-access == 0 && !root.last-message-read : VectorIcon {
        x: parent.width - 31px - time-label.preferred-width;
        y: 14px;
        name: "sent";
        tint: root.selected ? Theme.selected-ink : Theme.outgoing-check;
    }
    time-label := Text {
        x: parent.width - self.preferred-width - 10px;
        y: 9px;
        width: self.preferred-width;
        height: 20px;
        text: root.chat.time;
        color: root.selected ? Theme.selected-muted : Theme.muted;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    Text {
        x: 68px;
        y: 34px;
        width: max(0px, parent.width - (root.chat.unread > 0 ? 128px : 80px));
        height: 20px;
        text: root.chat.preview;
        color: root.selected ? Theme.selected-muted : Theme.muted;
        font-size: 13px;
        overflow: elide;
        vertical-alignment: center;
    }
    if root.chat.unread > 0 : Rectangle {
        x: parent.width - self.width - 10px;
        y: 34px;
        width: max(20px, unread-text.preferred-width + 12px);
        height: 20px;
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            border-radius: self.height / 2;
            background: root.selected ? #ffffff : Theme.accent;
        }
        unread-text := Text {
            width: parent.width;
            height: parent.height;
            text: root.unread-label;
            font-size: 12px;
            font-weight: 600;
            color: root.selected ? Theme.selected : #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.opened();
                return accept;
            }
            return reject;
        }
    }
    pointer := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.opened(); }
    }
}

component Bubble inherits Rectangle {
    callback selected();
    callback photo-requested();
    in property <MessageRow> message;
    in property <bool> is-read;
    in property <length> available-width;
    in property <bool> group-start: true;
    in property <bool> group-end: true;
    out property <bool> outgoing: message.outgoing && !message.channel-post;
    property <length> receipt-width: outgoing ? 20px : 0px;
    property <length> date-width: date-measure.preferred-width + receipt-width;
    property <string> display-text: root.message.is-photo ? "Открыть фото" + (root.message.body == "Фото" ? "" : "\n" + root.message.body) : root.message.body;
    property <bool> single-line: !root.message.is-photo && measure.preferred-height <= date-measure.preferred-height + 4px && measure.preferred-width + date-width + 34px <= available-width;
    property <length> body-width: min(max(measure.preferred-width + (single-line ? date-width + 34px : 22px), date-width + 34px), root.available-width);
    property <length> tail-width: root.group-end && Theme.design == 0 ? 6px : 0px;
    property <length> left-pad: !root.outgoing && root.group-end && Theme.design == 0 ? 6px : 0px;
    width: root.body-width + root.tail-width;
    height: max(35px, body.preferred-height + 16px + (single-line ? 0px : 16px));
    background: transparent;
    BubbleShape {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        fill: root.outgoing ? Theme.outgoing : Theme.incoming;
        tail-width: root.tail-width;
        tail: root.group-end && Theme.design == 0 ? (root.outgoing ? 2 : 1) : 0;
    }
    measure := Text {
        visible: false;
        text: root.display-text;
        font-size: 13px;
        font-weight: 400;
    }
    date-measure := Text {
        visible: false;
        text: root.message.time;
        font-size: 13px;
    }
    body := Text {
        x: root.left-pad + 11px;
        y: 8px;
        width: max(1px, root.body-width - 22px - (root.single-line ? root.date-width + 12px : 0px));
        height: self.preferred-height;
        text: root.display-text;
        font-size: 13px;
        font-weight: 400;
        color: root.message.is-photo ? Theme.accent : Theme.ink;
        wrap: word-wrap;
    }
    Text {
        x: root.left-pad + root.body-width - root.date-width - 9px;
        y: parent.height - 21px;
        width: date-measure.preferred-width;
        height: 18px;
        text: root.message.time;
        color: root.outgoing ? Theme.outgoing-muted : Theme.muted;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    if root.outgoing && root.is-read : VectorIcon {
        x: root.left-pad + root.body-width - 25px;
        y: parent.height - 16px;
        width: self.natural-width;
        height: self.natural-height;
        name: "read";
        tint: Theme.outgoing-check;
    }
    if root.outgoing && !root.is-read : VectorIcon {
        x: root.left-pad + root.body-width - 25px;
        y: parent.height - 16px;
        name: "sent";
        tint: Theme.outgoing-check;
    }
    TouchArea {
        width: parent.width; height: parent.height;
        mouse-cursor: root.message.is-photo ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.selected();
            }
        }
        clicked => { if root.message.is-photo { root.photo-requested(); } }
    }
}

export component Desktop inherits Window {
    title: "Relay Desktop";
    no-frame: true;
    default-font-family: "Open Sans";
    default-font-size: 13px;
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 400px;
    min-height: 420px;
    background: Theme.canvas;

    in property <[ChatRow]> chats;
    in property <[MessageRow]> messages;
    in property <ChatRow> active-chat;
    in-out property <string> query;
    in-out property <string> draft;
    in-out property <int> active-folder: 0;
    in property <[FolderRow]> folders;
    in-out property <bool> photo-open: false;
    in-out property <image> photo-image;
    in-out property <string> photo-status;
    in-out property <string> photo-title;
    in-out property <int> photo-index;
    in-out property <int> photo-count;
    in-out property <float> photo-zoom: 1;
    in-out property <bool> has-chat: false;
    in-out property <bool> show-chat: false;
    in-out property <bool> settings-open: false;
    in-out property <int> settings-page: 0;
    in property <string> settings-error;

    in-out property <bool> auth-required: true;
    in-out property <int> auth-step: 0;
    in-out property <string> auth-qr-matrix: "";
    in-out property <string> auth-country: "Russian Federation";
    in-out property <string> auth-phone: "+7 ";
    in-out property <string> auth-code: "";
    in-out property <string> auth-password: "";
    in-out property <string> auth-password-hint: "";
    in-out property <string> auth-error: "";
    in-out property <bool> auth-busy: false;
    in-out property <string> auth-delivery: "";
    in-out property <bool> connected: false;
    in-out property <bool> message-busy: false;
    in-out property <string> network-status: "";
    in-out property <int> selected-message: 0;
    in-out property <bool> selected-outgoing: false;
    in-out property <bool> selected-media: false;
    in-out property <string> selected-body: "";
    in-out property <int> reply-message: 0;
    in-out property <int> edit-message-id: 0;
    in-out property <bool> file-open: false;
    in-out property <string> file-path: "";
    in-out property <bool> chat-search-open: false;
    in-out property <string> chat-query: "";
    in-out property <bool> confirm-delete: false;
    in-out property <bool> forward-open: false;

    in-out property <string> user-name: "Relay Desktop";
    in-out property <string> user-phone: "+7 999 000-00-00";
    in-out property <string> user-username: "@relay_desktop";
    in-out property <string> user-initials: "R";

    callback auth-request-qr();
    callback auth-switch-to-phone();
    callback auth-switch-to-qr();
    callback auth-submit-phone();
    callback auth-submit-code();
    callback auth-submit-password();
    callback auth-open-demo();
    callback auth-logout();

    callback open-chat(int);
    callback request-avatar(int);
    callback select-folder(int);
    callback view-photo(int);
    callback step-photo(int);
    callback save-photo();
    callback join-channel();
    property <bool> chat-can-write: root.active-chat.channel-access == 0 || root.active-chat.channel-access == 2;
    callback send-message();
    callback send-file();
    callback message-action(string);
    callback load-older();
    callback search-chat();
    callback refresh-telegram();
    callback forward-message(int);
    callback open-first-result();
    callback query-edited();
    callback settings-changed();
    callback minimize-window();
    callback maximize-window();
    callback close-window();
    callback drag-window();
    callback resize-window();

    property <bool> compact: root.width < 740px;
    property <length> rail-width: root.compact ? 0px : 72px;
    property <length> sidebar-width: root.compact ? root.width : 325px;
    property <length> chat-left: root.compact ? 0px : root.rail-width + root.sidebar-width + 1px;
    in-out property <bool> menu-open: false;
    in-out property <bool> emoji-open: false;
    in-out property <bool> chat-menu-open: false;
    property <int> emoji-tab: 0;
    out property <float> menu-progress: menu-motion.value;
    out property <float> settings-progress: settings-motion.value;
    out property <float> compact-progress: compact-motion.value;
    out property <float> settings-page-progress: settings-page-motion.value;
    out property <float> layer-dim-progress: dim-motion.value;
    out property <float> auth-transition-progress: auth-screen.animation-progress;
    property <float> emoji-progress: emoji-motion.value;
    menu-motion := Motion { target: root.menu-open ? 1 : 0; curve: 1; }
    settings-motion := Motion { target: root.settings-open ? 1 : 0; }
    dim-motion := Motion {
        target: root.menu-open || root.settings-open ? 1 : 0;
        curve: root.menu-open || root.settings-open ? 1 : 0;
    }
    compact-motion := Motion {
        target: root.show-chat ? 1 : 0;
        curve: 1;
        duration: TelegramMotion.slide-duration;
    }
    settings-page-motion := Motion {
        target: root.settings-page;
        curve: 1;
        duration: TelegramMotion.slide-duration;
    }
    emoji-motion := Motion { target: root.emoji-open ? 1 : 0; curve: 1; duration: TelegramMotion.slide-duration; }

    forward-focus: keys;
    keys := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        enabled: !root.settings-open && !root.menu-open;
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "k" || event.text == "K") {
                root.show-chat = false;
                search.focus();
                return accept;
            }
            if event.text == Key.Escape {
                if root.chat-menu-open {
                    root.chat-menu-open = false;
                    return accept;
                }
                root.emoji-open = false;
                if root.query != "" {
                    root.query = "";
                    root.query-edited();
                } else {
                    root.has-chat = false;
                    root.show-chat = false;
                }
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: 0px;
            y: 26px;
            width: root.rail-width;
            height: root.height - 26px;
            visible: !root.compact;
            background: Theme.rail;

            Rectangle {
                x: 0px;
                y: 0px;
                width: 72px;
                height: 54px;
                background: rail-menu-hit.has-hover ? #ffffff0d : transparent;
                VectorIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: self.natural-width;
                    height: self.natural-height;
                    name: "menu";
                    tint: rail-menu-hit.has-hover ? #ffffff : Theme.rail-muted;
                }
                rail-menu-hit := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.menu-open = true; }
                }
            }

            ListView {
                y: 54px;
                width: parent.width;
                height: parent.height - 54px;
                viewport-width: self.width;
                viewport-height: root.folders.length * 64px;
                for folder[index] in root.folders : Rectangle {
                    property <bool> active: root.active-folder == folder.id;
                    property <int> unread: folder.unread;
                    x: 0px;
                    y: index * 64px;
                    width: 72px;
                    height: 64px;
                    background: active ? Theme.rail-active : folder-hit.has-hover ? #ffffff0a : transparent;
                    VectorIcon {
                        x: (parent.width - self.width) / 2;
                        y: 4px;
                        width: self.natural-width;
                        height: self.natural-height;
                        name: folder.id == 0 ? "chats" : "folder";
                        tint: active ? Theme.rail-accent : folder-hit.has-hover ? #99aec2 : Theme.rail-muted;
                    }
                    if unread > 0 : Rectangle {
                        x: parent.width - self.width - 4px;
                        y: 5px;
                        width: max(18px, badge-lbl.preferred-width + 10px);
                        height: 18px;
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            border-radius: self.height / 2;
                            background: active ? Theme.rail-accent : Theme.rail-muted;
                            border-color: active ? Theme.rail-active : Theme.rail;
                            border-width: 2px;
                        }
                        badge-lbl := Text {
                            width: parent.width;
                            height: parent.height;
                            text: unread > 99 ? "99+" : "\{unread}";
                            font-size: 10px;
                            font-weight: 600;
                            color: active ? Theme.rail-active : Theme.rail;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        x: 2px;
                        y: 41px;
                        width: 68px;
                        height: 16px;
                        text: folder.title;
                        color: active ? Theme.rail-accent : folder-hit.has-hover ? #99aec2 : Theme.rail-muted;
                        font-size: 11px;
                        font-weight: active ? 600 : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    folder-hit := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.select-folder(folder.id); }
                    }
                }
            }
        }

        Rectangle {
            x: root.rail-width - (root.compact ? TelegramMotion.slide-shift * root.compact-progress : 0px);
            y: 26px;
            width: root.sidebar-width;
            height: root.height - 26px;
            visible: !root.compact || root.compact-progress < 1;
            background: Theme.surface;
            if root.compact : IconButton {
                x: 7px;
                y: 7px;
                icon: "menu";
                label: "Main menu";
                clicked => { root.menu-open = true; }
            }
            search := Entry {
                x: root.compact ? 54px : 10px;
                y: 10px;
                width: parent.width - self.x - 10px;
                height: 34px;
                text <=> root.query;
                placeholder: "Search or @username";
                edited => { root.query-edited(); }
                accepted => { root.open-first-result(); }
            }
            if root.compact && root.folders.length > 1 : Flickable {
                x: 0px; y: 53px; width: parent.width; height: 36px;
                viewport-width: max(self.width, root.folders.length * 112px + 8px);
                viewport-height: self.height;
                for folder[index] in root.folders : ActionButton {
                    x: 4px + index * 112px; y: 2px; width: 108px; height: 32px;
                    text: folder.title;
                    selected: root.active-folder == folder.id;
                    clicked => { root.select-folder(folder.id); }
                }
            }
            chat-list := ListView {
                x: 0px;
                y: root.compact && root.folders.length > 1 ? 92px : 54px;
                width: parent.width;
                height: parent.height - self.y;
                viewport-width: self.width;
                for chat[index] in root.chats : ChatTile {
                    width: root.sidebar-width;
                    chat: chat;
                    row-index: index;
                    list-viewport-y: chat-list.viewport-y;
                    list-height: chat-list.height;
                    list-visible: !root.auth-required && (!root.compact || root.compact-progress < 1) && !root.forward-open;
                    selected: root.has-chat && chat.id == root.active-chat.id;
                    avatar-requested(id) => { root.request-avatar(id); }
                    opened => { root.chat-menu-open = false; root.open-chat(chat.id); }
                }
            }
            if root.chats.length == 0 : Text {
                y: 110px;
                width: parent.width;
                text: "No chats found";
                color: Theme.muted;
                font-size: 13px;
                horizontal-alignment: center;
            }
            if root.compact : Rectangle {
                background: #0000003c;
                opacity: root.compact-progress;
            }
        }

        if !root.compact : Rectangle {
            x: root.rail-width + root.sidebar-width;
            y: 26px;
            width: 1px;
            height: root.height - 26px;
            background: Theme.border;
        }

        Rectangle {
            x: root.compact ? root.width * (1 - root.compact-progress) : root.chat-left;
            y: 26px;
            width: root.compact ? root.width : root.width - root.chat-left;
            height: root.height - 26px;
            visible: !root.compact || root.compact-progress > 0;
            background: Theme.canvas;
            if root.compact && root.compact-progress > 0 && root.compact-progress < 1 : Rectangle {
                x: -12px; width: 12px; height: parent.height;
                background: @linear-gradient(90deg, #00000000, #00000040);
                opacity: root.compact-progress;
            }

            if !root.has-chat : Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: empty-label.preferred-width + 24px;
                height: 26px;
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    border-radius: self.height / 2;
                    background: Theme.service-bg;
                }
                empty-label := Text {
                    width: parent.width;
                    height: parent.height;
                    text: "Select a chat to start messaging";
                    color: Theme.service-fg;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            header := Rectangle {
                x: 0px;
                y: 0px;
                width: history.width;
                height: 54px;
                visible: root.has-chat;
                background: Theme.surface;
                if root.compact : IconButton {
                    x: 6px;
                    y: 7px;
                    icon: "back";
                    label: "Back";
                    clicked => { root.show-chat = false; }
                }
                Text {
                    x: root.compact ? 54px : 18px;
                    y: root.active-chat.id == 3 ? 17px : 8px;
                    width: parent.width - self.x - 180px;
                    height: 20px;
                    text: root.active-chat.title;
                    color: Theme.ink;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.active-chat.id != 3 : Text {
                    x: root.compact ? 54px : 18px;
                    y: 29px;
                    width: parent.width - self.x - 180px;
                    height: 18px;
                    text: root.connected ? "Telegram" : "Demo";
                    font-size: 13px;
                    color: Theme.muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
                IconButton {
                    x: parent.width - 172px;
                    y: 7px;
                    icon: "search";
                    label: "Search";
                    clicked => { root.chat-search-open = !root.chat-search-open; }
                }
                IconButton {
                    x: parent.width - 130px;
                    y: 7px;
                    icon: "call";
                    label: "Calls require a Telegram connection";
                    enabled: false;
                }
                IconButton {
                    x: parent.width - 88px;
                    y: 7px;
                    icon: "panel";
                    label: "Emoji panel";
                    active: root.emoji-open;
                    clicked => { root.emoji-open = !root.emoji-open; }
                }
                IconButton {
                    x: parent.width - 46px;
                    y: 7px;
                    icon: "more";
                    label: "Chat menu";
                    clicked => {
                        root.selected-message = 0;
                        root.chat-menu-open = !root.chat-menu-open;
                    }
                }
                Rectangle {
                    x: 0px;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border;
                }
            }

            history := Flickable {
                x: 0px;
                y: 54px;
                width: parent.width - (root.compact ? 0px : 292px * root.emoji-progress);
                height: parent.height - 100px;
                visible: root.has-chat;
                viewport-width: self.width;
                viewport-height: max(self.height, history-items.preferred-height);
                history-items := VerticalLayout {
                    width: history.width;
                    height: self.preferred-height;
                    y: max(0px, history.height - self.height);
                    padding: 0px;
                    spacing: 0px;
                    for message[index] in root.messages : Rectangle {
                        property <bool> date-start: index == 0 || root.messages[index - 1].date != message.date;
                        property <bool> group-start: date-start || root.messages[index - 1].outgoing != message.outgoing || root.messages[index - 1].service;
                        property <bool> group-end: index + 1 == root.messages.length || root.messages[index + 1].outgoing != message.outgoing || root.messages[index + 1].date != message.date || root.messages[index + 1].service;
                        property <length> top-offset: date-start ? 40px : (group-start ? 6px : 0px);
                        property <length> bottom-pad: index + 1 == root.messages.length ? 8px : 2px;
                        property <length> edge-pad: group-end && Theme.design == 0 ? 10px : 16px;
                        width: history.width;
                        height: (message.service ? 28px : bubble.height) + top-offset + bottom-pad;
                        if date-start : Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: 12px;
                            width: date-pill.preferred-width + 22px;
                            height: 24px;
                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                border-radius: self.height / 2;
                                background: Theme.service-bg;
                            }
                            date-pill := Text {
                                width: parent.width;
                                height: parent.height;
                                text: message.date != "" ? message.date : "Demo";
                                color: Theme.service-fg;
                                font-size: 13px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        bubble := Bubble {
                            visible: !message.service;
                            x: self.outgoing ? parent.width - self.width - parent.edge-pad : parent.edge-pad;
                            y: parent.top-offset;
                            message: message;
                            is-read: root.active-chat.id == 3 || message.id <= root.active-chat.read-outbox-max-id;
                            group-start: parent.group-start;
                            group-end: parent.group-end;
                            available-width: min(430px, history.width - 48px);
                            photo-requested => { root.view-photo(message.id); }
                            selected => {
                                root.selected-message = message.id;
                                root.selected-body = message.body;
                                root.selected-outgoing = message.outgoing;
                                root.selected-media = message.has-media;
                                root.chat-menu-open = true;
                            }
                        }
                        if message.service : Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: parent.top-offset;
                            width: min(history.width - 32px, service-label.preferred-width + 24px);
                            height: 26px;
                            Rectangle {
                                width: parent.width; height: parent.height;
                                border-radius: self.height / 2;
                                background: Theme.service-bg;
                            }
                            service-label := Text {
                                x: 12px; width: parent.width - 24px; height: parent.height;
                                text: message.body; color: Theme.service-fg; font-size: 13px;
                                font-weight: 600; overflow: elide;
                                vertical-alignment: center; horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            Rectangle {
                visible: root.has-chat && history.viewport-height > history.height;
                x: history.width - 6px;
                y: history.y + min(history.height - self.height, max(0px,
                    -history.viewport-y * (history.height - self.height)
                    / max(1px, history.viewport-height - history.height)));
                width: 4px;
                height: min(history.height, max(24px,
                    history.height * history.height / max(1px, history.viewport-height)));
                background: Theme.dark ? #7f84897a : #7f84894c;
                border-radius: 2px;
            }

            Rectangle {
                x: 0px;
                y: parent.height - 46px;
                width: history.width;
                height: 46px;
                visible: root.has-chat;
                background: Theme.surface;
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border;
                }
                IconButton {
                    x: 5px;
                    y: 3px;
                    icon: "clip";
                    label: "Send a file";
                    visible: root.chat-can-write;
                    enabled: root.connected && !root.message-busy && root.edit-message-id == 0;
                    clicked => { root.file-open = true; }
                }
                composer := Entry {
                    x: 46px;
                    y: 3px;
                    width: parent.width - 134px;
                    height: 40px;
                    text <=> root.draft;
                    visible: root.chat-can-write;
                    read-only: root.message-busy;
                    placeholder: root.edit-message-id > 0 ? "Edit message..." : root.reply-message > 0 ? "Reply..." : root.active-chat.channel-access == 2 ? "Опубликовать запись…" : "Write a message...";
                    plain: Theme.design == 0;
                    accepted => { root.send-message(); }
                }
                IconButton {
                    x: parent.width - 86px;
                    y: 3px;
                    icon: "smile";
                    label: "Emoji";
                    visible: root.chat-can-write;
                    active: root.emoji-open;
                    clicked => { root.emoji-open = !root.emoji-open; }
                }
                IconButton {
                    x: parent.width - 44px;
                    y: 3px;
                    icon: root.draft == "" ? "mic" : "send";
                    label: "Send message";
                    visible: root.chat-can-write;
                    active: root.draft != "";
                    enabled: root.draft != "" && !root.message-busy;
                    clicked => { root.send-message(); composer.focus(); }
                }
                if root.active-chat.channel-access == 1 : Text {
                    width: parent.width;
                    height: parent.height;
                    text: "Канал · только чтение";
                    color: Theme.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.active-chat.channel-access == 3 : ActionButton {
                    x: (parent.width - self.width) / 2;
                    y: 4px;
                    width: 180px;
                    height: 38px;
                    text: root.message-busy ? "Подключение…" : "Подписаться";
                    primary: true;
                    enabled: !root.message-busy;
                    clicked => { root.join-channel(); }
                }
            }

            if root.chat-search-open : Rectangle {
                x: 0px; y: 54px; width: history.width; height: 46px; background: Theme.surface;
                Entry { x: 8px; y: 3px; width: parent.width - 100px; height: 40px; text <=> root.chat-query; placeholder: "Search messages in this chat"; accepted => { root.search-chat(); } }
                ActionButton { x: parent.width - 84px; y: 5px; width: 76px; height: 36px; text: "Search"; clicked => { root.search-chat(); } }
            }

            Rectangle {
                width: parent.width;
                height: parent.height;
                visible: root.has-chat && (root.chat-menu-open || chat-popup.visible);
                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.chat-menu-open = false; }
                }
                chat-popup := PopupReveal {
                    shown: root.chat-menu-open;
                    x: max(4px, history.width - self.width - 8px);
                    y: 50px;
                    content-width: 218px;
                    content-height: menu-items.preferred-height + 8px;
                    fill: Theme.surface;
                    menu-items := VerticalLayout {
                        x: 1px; y: 4px; width: parent.width - 2px;
                        padding: 0px; spacing: 0px;
                        if root.selected-message > 0 && root.chat-can-write : MenuItem { text: "Ответить"; clicked => { root.chat-menu-open = false; root.message-action("reply"); } }
                        if root.selected-message > 0 : MenuItem { text: "Переслать"; clicked => { root.chat-menu-open = false; root.message-action("forward"); } }
                        if root.selected-message > 0 && root.selected-outgoing && !root.selected-media : MenuItem { text: "Изменить"; clicked => { root.chat-menu-open = false; root.message-action("edit"); } }
                        if root.selected-message > 0 && (root.active-chat.channel-access == 0 || (root.selected-outgoing && root.chat-can-write)) : MenuItem { text: "Удалить…"; clicked => { root.chat-menu-open = false; root.message-action("delete"); } }
                        if root.selected-message > 0 && root.selected-media : MenuItem { text: "Сохранить файл"; clicked => { root.chat-menu-open = false; root.message-action("download"); } }
                        if root.reply-message > 0 || root.edit-message-id > 0 : MenuItem { text: root.edit-message-id > 0 ? "Отменить редактирование" : "Отменить ответ"; clicked => { root.chat-menu-open = false; root.message-action("cancel"); } }
                        MenuItem { text: "Ранние сообщения"; enabled: root.connected; clicked => { root.chat-menu-open = false; root.load-older(); } }
                        MenuItem { text: "Обновить"; enabled: root.connected; clicked => { root.chat-menu-open = false; root.refresh-telegram(); } }
                        MenuItem { text: "Оформление"; clicked => { root.chat-menu-open = false; root.settings-page = 1; root.settings-open = true; } }
                    }
                }
            }

            Rectangle {
                x: parent.width - self.width * root.emoji-progress;
                y: 0px;
                width: root.compact ? parent.width : 292px;
                height: parent.height;
                visible: root.has-chat && root.emoji-progress > 0;
                background: Theme.surface;
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 1px;
                    height: parent.height;
                    background: Theme.border;
                }
                Rectangle {
                    x: 0px;
                    y: 53px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    x: 12px;
                    y: 9px;
                    width: parent.width - 24px;
                    height: 36px;
                    spacing: 4px;
                    for name[index] in ["Emoji", "Stickers", "GIFs"] : ActionButton {
                        text: name;
                        selected: root.emoji-tab == index;
                        clicked => { root.emoji-tab = index; }
                    }
                }
                if root.emoji-tab == 0 : Text {
                    x: 18px;
                    y: 66px;
                    text: "Smileys & People";
                    color: Theme.muted;
                    font-size: 12px;
                    font-weight: 600;
                }
                if root.emoji-tab == 0 : Rectangle {
                    x: 12px;
                    y: 90px;
                    width: parent.width - 24px;
                    height: 132px;
                    HorizontalLayout {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 40px;
                        spacing: 4px;
                        for emoji in ["😀", "😄", "😂", "🥰", "😍", "👍"] : ActionButton {
                            text: emoji;
                            clicked => { root.draft += emoji; composer.focus(); }
                        }
                    }
                    HorizontalLayout {
                        x: 0px;
                        y: 44px;
                        width: parent.width;
                        height: 40px;
                        spacing: 4px;
                        for emoji in ["❤️", "🔥", "🎉", "👋", "😊", "🤝"] : ActionButton {
                            text: emoji;
                            clicked => { root.draft += emoji; composer.focus(); }
                        }
                    }
                    HorizontalLayout {
                        x: 0px;
                        y: 88px;
                        width: parent.width;
                        height: 40px;
                        spacing: 4px;
                        for emoji in ["😎", "🤔", "🙌", "✨", "🚀", "✅"] : ActionButton {
                            text: emoji;
                            clicked => { root.draft += emoji; composer.focus(); }
                        }
                    }
                }
                if root.emoji-tab != 0 : Text {
                    x: 20px;
                    y: 120px;
                    width: parent.width - 40px;
                    text: "Available after Telegram connection";
                    wrap: word-wrap;
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    if !root.auth-required && root.network-status != "" : Rectangle {
        x: root.chat-left + 8px; y: 36px;
        width: max(250px, root.width - root.chat-left - 16px); height: 44px;
        background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: 6px;
        Text { x: 8px; y: 4px; width: parent.width - 48px; height: parent.height - 8px; text: root.network-status; color: Theme.ink; wrap: word-wrap; font-size: 12px; }
        IconButton { x: parent.width - 40px; y: 2px; icon: "close"; label: "Dismiss"; clicked => { root.network-status = ""; } }
    }

    BoxOverlay {
        shown: root.forward-open && !root.auth-required;
        width: root.width; height: root.height;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(420px, parent.width - 24px); height: min(500px, parent.height - 40px); background: Theme.surface;
            Text { x: 18px; y: 16px; text: "Forward to…"; color: Theme.ink; font-size: 17px; }
            IconButton { x: parent.width - 44px; y: 8px; icon: "close"; label: "Cancel"; clicked => { root.forward-open = false; } }
            forward-list := ListView {
                x: 0px; y: 54px; width: parent.width; height: parent.height - 54px; viewport-width: self.width;
                for chat[index] in root.chats : ChatTile {
                    width: parent.width;
                    chat: chat;
                    row-index: index;
                    list-viewport-y: forward-list.viewport-y;
                    list-height: forward-list.height;
                    list-visible: root.forward-open && !root.auth-required;
                    selected: false;
                    avatar-requested(id) => { root.request-avatar(id); }
                    opened => { root.forward-message(chat.id); }
                }
            }
        }
    }

    BoxOverlay {
        shown: root.file-open && !root.auth-required;
        width: root.width; height: root.height;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - 210px) / 2;
            width: min(480px, parent.width - 24px); height: 210px;
            background: Theme.surface; border-radius: 8px;
            Text { x: 18px; y: 18px; text: "Send photo, video or file"; color: Theme.ink; font-size: 17px; }
            Text { x: 18px; y: 54px; width: parent.width - 36px; text: "Paste the full file path. The composer text becomes its caption."; color: Theme.muted; wrap: word-wrap; }
            Entry { x: 18px; y: 92px; width: parent.width - 36px; height: 40px; text <=> root.file-path; placeholder: "C:\\Users\\…\\photo.jpg"; accepted => { root.send-file(); } }
            HorizontalLayout {
                x: 18px; y: 154px; width: parent.width - 36px; height: 36px; spacing: 12px;
                ActionButton { text: "Cancel"; clicked => { root.file-open = false; } }
                ActionButton { text: "Send"; primary: true; enabled: root.file-path != "" && !root.message-busy; clicked => { root.send-file(); } }
            }
        }
    }

    BoxOverlay {
        shown: root.confirm-delete && !root.auth-required;
        width: root.width; height: root.height;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - 160px) / 2;
            width: min(420px, parent.width - 24px); height: 160px; background: Theme.surface; border-radius: 8px;
            Text { x: 18px; y: 20px; width: parent.width - 36px; text: "Delete this message for everyone? This cannot be undone."; color: Theme.ink; wrap: word-wrap; }
            HorizontalLayout {
                x: 18px; y: 106px; width: parent.width - 36px; height: 36px; spacing: 12px;
                ActionButton { text: "Cancel"; clicked => { root.confirm-delete = false; } }
                ActionButton { text: "Delete"; clicked => { root.message-action("confirm-delete"); root.confirm-delete = false; } }
            }
        }
    }

    Rectangle {
        visible: root.photo-open && !root.auth-required;
        x: 0px; y: 26px; width: root.width; height: root.height - 26px;
        background: #101318f5;
        TouchArea { width: parent.width; height: parent.height; }
        photo-keys := FocusScope {
            width: parent.width; height: parent.height;
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-photo(); return accept; }
                if event.text == Key.LeftArrow { root.step-photo(-1); return accept; }
                if event.text == Key.RightArrow { root.step-photo(1); return accept; }
                return reject;
            }
        }
        photo-viewport := Flickable {
            visible: root.photo-status == "";
            x: 52px; y: 50px; width: parent.width - 104px; height: parent.height - 112px;
            viewport-width: self.width * root.photo-zoom;
            viewport-height: self.height * root.photo-zoom;
            Image {
                width: photo-viewport.viewport-width;
                height: photo-viewport.viewport-height;
                source: root.photo-image;
                image-fit: contain;
            }
        }
        Text {
            x: 18px; y: 8px; width: parent.width - 136px; height: 34px;
            text: root.photo-title + "  ·  " + "\{root.photo-index} / \{root.photo-count}";
            color: #ffffff; font-size: 15px; overflow: elide; vertical-alignment: center;
        }
        ActionButton {
            x: 8px; y: (parent.height - self.height) / 2; width: 40px; height: 44px;
            text: "‹"; enabled: root.photo-index > 1;
            clicked => { root.step-photo(-1); }
        }
        ActionButton {
            x: parent.width - 48px; y: (parent.height - self.height) / 2; width: 40px; height: 44px;
            text: "›"; enabled: root.photo-index < root.photo-count;
            clicked => { root.step-photo(1); }
        }
        HorizontalLayout {
            x: (parent.width - self.width) / 2; y: parent.height - 52px; width: 288px; height: 38px; spacing: 6px;
            ActionButton { text: "−"; enabled: root.photo-zoom > 1; clicked => { root.zoom-photo(max(1, root.photo-zoom - 0.5)); } }
            ActionButton { text: "По размеру"; clicked => { root.zoom-photo(1); } }
            ActionButton { text: "+"; enabled: root.photo-status == "" && root.photo-zoom < 4; clicked => { root.zoom-photo(min(4, root.photo-zoom + 0.5)); } }
            ActionButton { text: "Сохранить"; enabled: root.photo-status == ""; clicked => { root.save-photo(); } }
        }
        if root.photo-status != "" : Text {
            x: 24px; y: 48px; width: parent.width - 48px; height: parent.height - 68px;
            text: root.photo-status; color: #ffffff; wrap: word-wrap;
            horizontal-alignment: center; vertical-alignment: center;
        }
        ActionButton {
            x: parent.width - 104px; y: 8px; width: 92px; height: 34px;
            text: "Закрыть";
            clicked => { root.close-photo(); }
        }
    }

    auth-screen := AuthScreen {
        visible: root.auth-required;
        x: 0px;
        y: 26px;
        width: root.width;
        height: root.height - 26px;
        step <=> root.auth-step;
        qr-matrix: root.auth-qr-matrix;
        country <=> root.auth-country;
        phone <=> root.auth-phone;
        code <=> root.auth-code;
        password <=> root.auth-password;
        password-hint: root.auth-password-hint;
        error-text: root.auth-error;
        busy: root.auth-busy;
        delivery: root.auth-delivery;
        request-qr => { root.auth-request-qr(); }
        switch-to-phone => { root.auth-switch-to-phone(); }
        switch-to-qr => { root.auth-switch-to-qr(); }
        submit-phone => { root.auth-submit-phone(); }
        submit-code => { root.auth-submit-code(); }
        submit-password => { root.auth-submit-password(); }
        open-demo => { root.auth-open-demo(); }
        open-settings => {
            root.settings-page = 1;
            root.settings-open = true;
        }
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: 26px;
        background: Theme.titlebar;
        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width - 108px;
            height: parent.height;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.drag-window();
                }
            }
            double-clicked => { root.maximize-window(); }
        }
        for symbol[index] in ["−", "□", "×"] : Rectangle {
            x: parent.width - 108px + index * 36px;
            y: 0px;
            width: 36px;
            height: 26px;
            background: title-hit.has-hover ? (index == 2 ? #e81123 : Theme.titlebar-hover) : transparent;
            VectorIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: self.natural-width;
                height: self.natural-height;
                name: index == 0 ? "minimize" : index == 1 ? "maximize" : "window-close";
                tint: title-hit.has-hover ? (index == 2 ? #ffffff : Theme.titlebar-hover-fg) : Theme.titlebar-fg;
            }
            title-hit := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    if index == 0 { root.minimize-window(); }
                    else if index == 1 { root.maximize-window(); }
                    else { root.close-window(); }
                }
            }
        }
    }

    Rectangle {
        x: 0px; y: 26px; width: root.width; height: root.height - 26px;
        visible: root.layer-dim-progress > 0;
        background: rgba(0, 0, 0, (127 / 255) * root.layer-dim-progress);
    }
    Rectangle {
        x: 0px;
        visible: root.menu-progress > 0;
        y: 26px;
        width: root.width;
        height: root.height - 26px;
        background: transparent;
        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.menu-open = false; }
        }
        Rectangle {
            x: -274px * (1 - root.menu-progress);
            y: 0px;
            width: 274px;
            height: parent.height;
            background: Theme.surface;
            TouchArea { width: parent.width; height: parent.height; }
            Avatar {
                x: 22px;
                y: 20px;
                width: 48px;
                height: 48px;
                initials: root.user-initials;
                tint-top: #72d5fd;
                tint: #2a9ef1;
            }
            Text {
                x: 24px;
                y: 84px;
                width: 226px;
                text: root.user-name;
                color: Theme.ink;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                x: 24px;
                y: 105px;
                width: 226px;
                text: root.user-phone != "" ? root.user-phone : "Set Emoji Status";
                color: Theme.accent;
                font-size: 12px;
                overflow: elide;
            }
            Rectangle {
                x: 0px;
                y: 136px;
                width: parent.width;
                height: 1px;
                background: Theme.border;
            }
            for name[index] in ["My Profile", "New Group", "New Channel", "Contacts", "Calls",
                "Saved Messages", "Settings", "Night Mode"] : Rectangle {
                x: 0px;
                y: 144px + index * 40px + (index > 0 ? 8px : 0px);
                width: parent.width;
                height: 40px;
                background: menu-hit.has-hover ? Theme.hover : transparent;
                RippleSurface {
                    pressed: menu-hit.pressed;
                    press-x: menu-hit.mouse-x;
                    press-y: menu-hit.mouse-y;
                    ink: Theme.ripple;
                }
                if index == 1 : Rectangle {
                    x: 0px;
                    y: -4px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border;
                }
                VectorIcon {
                    x: 21px;
                    y: (parent.height - self.height) / 2;
                    width: self.natural-width;
                    height: self.natural-height;
                    name: index == 0 ? "profile"
                        : index == 1 ? "groups_create"
                        : index == 2 ? "channel"
                        : index == 3 ? "personal"
                        : index == 4 ? "phone"
                        : index == 5 ? "saved"
                        : index == 6 ? "settings" : "moon";
                    tint: Theme.menu-icon-fg;
                }
                Text {
                    x: 64px;
                    width: parent.width - 74px;
                    height: parent.height;
                    text: name;
                    color: Theme.ink;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                if index == 7 : Rectangle {
                    x: 216px;
                    y: 12px;
                    width: 34px;
                    height: 16px;
                    toggle-motion := Motion { target: Theme.dark ? 1 : 0; duration: TelegramMotion.toggle-duration; }
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        border-radius: self.height / 2;
                        background: Theme.dark ? Theme.accent : Theme.muted;
                        animate background { duration: TelegramMotion.toggle-duration; easing: linear; }
                    }
                    Rectangle {
                        x: 2px + 16px * toggle-motion.value;
                        y: 1px;
                        width: 14px;
                        height: 14px;
                        border-radius: self.height / 2;
                        background: Theme.surface;
                    }
                }
                menu-hit := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: index >= 5 || index == 0 ? MouseCursor.pointer : MouseCursor.default;
                    enabled: root.menu-open && (index >= 5 || index == 0);
                    clicked => {
                        if index == 7 {
                            Theme.dark = !Theme.dark;
                            root.settings-changed();
                        } else {
                            root.menu-open = false;
                            if index == 5 { root.open-chat(3); }
                            else {
                                root.settings-page = 0;
                                root.settings-open = true;
                            }
                        }
                    }
                }
            }
            Text {
                x: 24px;
                y: parent.height - 52px;
                text: "Telegram Desktop\nVersion 7.4.1 x64 — Relay UI";
                font-size: 12px;
                color: Theme.muted;
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 26px;
        visible: root.settings-progress > 0;
        width: root.width;
        height: root.height - 26px;
        background: transparent;
        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.settings-open = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(392px, parent.width - 24px);
            height: min(620px, parent.height - 32px);
            background: transparent;
            opacity: root.settings-progress;
            clip: true;
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                border-radius: Theme.material ? 24px : 8px;
                background: Theme.surface;
            }
            TouchArea { width: parent.width; height: parent.height; }
            Text {
                x: 22px - TelegramMotion.slide-shift * root.settings-page-progress;
                y: 16px;
                text: "Settings";
                visible: root.settings-page-progress < 1;
                font-size: 16px;
                font-weight: 600;
                color: Theme.ink;
            }
            Text {
                x: 56px + parent.width * (1 - root.settings-page-progress);
                y: 16px;
                text: "Chat Settings";
                visible: root.settings-page-progress > 0;
                font-size: 16px;
                font-weight: 600;
                color: Theme.ink;
            }
            IconButton {
                x: parent.width - 46px;
                y: 7px;
                icon: "close";
                label: "Close settings";
                clicked => { root.settings-open = false; }
            }
            IconButton {
                x: 8px + parent.width * (1 - root.settings-page-progress);
                y: 7px;
                visible: root.settings-page-progress > 0;
                icon: "back";
                label: "Back to settings";
                clicked => { root.settings-page = 0; }
            }
            SettingsHome {
                x: -TelegramMotion.slide-shift * root.settings-page-progress;
                y: 54px;
                visible: root.settings-page-progress < 1;
                width: parent.width;
                height: parent.height - 54px;
                user-name: root.user-name;
                user-phone: root.user-phone;
                user-username: root.user-username;
                user-initials: root.user-initials;
                appearance-requested => { root.settings-page = 1; }
                logout-requested => {
                    root.settings-open = false;
                    root.auth-logout();
                }
            }
            Rectangle {
                y: 54px; width: parent.width; height: parent.height - 54px;
                background: #0000003c;
                opacity: root.settings-page-progress;
                visible: root.settings-page-progress > 0 && root.settings-page-progress < 1;
            }
            Rectangle {
                x: parent.width * (1 - root.settings-page-progress);
                y: 54px;
                width: parent.width;
                height: parent.height - 54px;
                visible: root.settings-page-progress > 0;
                background: Theme.surface;
                Rectangle {
                    x: -12px; width: 12px; height: parent.height;
                    background: @linear-gradient(90deg, #00000000, #00000040);
                    opacity: root.settings-page-progress;
                }
                Text {
                    x: 22px;
                    y: 14px;
                    text: "Color theme";
                    color: Theme.accent;
                    font-size: 13px;
                    font-weight: 600;
                }
                HorizontalLayout {
                    x: 22px;
                    y: 44px;
                    width: parent.width - 44px;
                    height: 86px;
                    spacing: 10px;
                    for name[index] in ["Telegram", "Material You", "WinUI 3"] : Rectangle {
                        background: index == 1 ? (Theme.dark ? #292632 : #ece6f5) : Theme.canvas;
                        border-radius: index == 1 ? 14px : 6px;
                        border-width: Theme.design == index ? 2px : 1px;
                        border-color: Theme.design == index ? Theme.accent : Theme.border;
                        Rectangle {
                            x: 10px; y: 12px;
                            width: parent.width * 0.57; height: 12px;
                            border-radius: index == 1 ? 6px : 4px;
                            background: Theme.incoming;
                        }
                        Rectangle {
                            x: parent.width * 0.36; y: 31px;
                            width: parent.width * 0.53; height: 12px;
                            border-radius: index == 1 ? 6px : 4px;
                            background: Theme.outgoing;
                        }
                        Text {
                            y: 58px;
                            width: parent.width;
                            height: 20px;
                            text: name;
                            color: Theme.design == index ? Theme.accent : Theme.ink;
                            font-size: 11px;
                            font-weight: Theme.design == index ? 600 : 400;
                            horizontal-alignment: center;
                        }
                        TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { Theme.design = index; root.settings-changed(); }
                        }
                    }
                }
                Text {
                    x: 22px;
                    y: 158px;
                    text: "Color mode";
                    font-size: 13px;
                    color: Theme.ink;
                }
                ActionButton {
                    x: parent.width - 108px;
                    y: 148px;
                    width: 86px;
                    height: 36px;
                    text: Theme.dark ? "Night" : "Day";
                    selected: true;
                    clicked => { Theme.dark = !Theme.dark; root.settings-changed(); }
                }
                HorizontalLayout {
                    x: 22px;
                    y: 204px;
                    width: parent.width - 44px;
                    height: 36px;
                    spacing: 8px;
                    visible: Theme.material;
                    for swatch[index] in [#4266a7, #38745b, #76549a] : ActionButton {
                        text: index == 0 ? "Blue" : index == 1 ? "Green" : "Purple";
                        selected: Theme.seed == swatch;
                        clicked => { Theme.seed = swatch; root.settings-changed(); }
                    }
                }
                Text {
                    x: 22px;
                    y: 266px;
                    width: parent.width - 44px;
                    text: root.settings-error != "" ? root.settings-error
                        : (root.connected ? "Connected to Telegram" : "Demo mode");
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
            if !root.settings-open || (root.settings-page-progress > 0 && root.settings-page-progress < 1) : TouchArea {
                width: parent.width; height: parent.height;
            }
        }
    }

    TouchArea {
        x: root.width - 8px;
        y: root.height - 8px;
        width: 8px;
        height: 8px;
        mouse-cursor: MouseCursor.se-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.resize-window();
            }
        }
    }

    public function focus-composer() { composer.focus(); }
    public function focus-photo() { root.zoom-photo(1); }
    function zoom-photo(factor: float) {
        root.photo-zoom = factor;
        photo-viewport.viewport-x = (photo-viewport.width - photo-viewport.viewport-width) / 2;
        photo-viewport.viewport-y = (photo-viewport.height - photo-viewport.viewport-height) / 2;
        photo-keys.focus();
    }
    function close-photo() {
        root.photo-open = false;
        root.photo-status = "";
        composer.focus();
    }
    public function scroll-to-bottom() {
        history.viewport-y = min(0px, history.height - history.viewport-height);
    }
}
