import { VectorIcon } from "icons/vector-icons.slint";
import { TelegramMotion, RippleSurface } from "motion.slint";
export global Theme {
    callback open-profile(string);
    in-out property <bool> show-gifts: true;
    in-out property <int> design: 0;
    in-out property <bool> dark: true;
    in-out property <color> seed: #4266a7;

    out property <bool> material: design == 1;
    out property <bool> fluent: design == 2;
    out property <color> accent: material ? seed : (dark ? #5288c1 : #40a7e3);
    out property <color> surface: material
        ? (dark ? #1b1b20 : #faf8ff)
        : (dark ? #17212b : #ffffff);
    out property <color> canvas: material
        ? (dark ? #141318 : #f0eef6)
        : fluent ? (dark ? #202020 : #f3f3f3)
        : (dark ? #0e1621 : #dce6de);
    out property <color> rail: dark ? #0e1621 : #293a4c;
    out property <color> rail-active: dark ? #17212b : #17212b;
    out property <color> rail-muted: dark ? #768c9e : #8294a5;
    out property <color> rail-accent: dark ? #5eb5f7 : #64c2ff;
    out property <color> titlebar: dark ? #242f3d : #f1f1f1;
    out property <color> titlebar-fg: dark ? #8c9aa9 : #a8a8a8;
    out property <color> titlebar-hover: dark ? #2c3847 : #e3e3e3;
    out property <color> titlebar-hover-fg: dark ? #d9dcdf : #666666;
    out property <color> hover: dark ? #202b36 : #f1f1f1;
    out property <color> incoming: dark ? #182533 : #ffffff;
    out property <color> service-bg: dark ? #1e2c3a99 : #4a573840;
    out property <color> service-fg: #ffffff;
    out property <color> ink: dark ? #f5f5f5 : #000000;
    out property <color> muted: dark ? #6c7883 : #999999;
    out property <color> icon-fg: dark ? #6c7883 : #a8a8a8;
    out property <color> icon-hover-fg: dark ? #737e87 : #999999;
    out property <color> menu-icon-fg: dark ? #737e87 : #a8a8a8;
    out property <color> ripple: dark ? #24303d : #e5e5e5;
    out property <color> active-ripple: dark ? #3b7cb1 : #2095d0;
    out property <color> dialog-ripple: dark ? #25313d : #e5e5e5;
    out property <color> selected-dialog-ripple: dark ? #315a80 : #2095d0;
    out property <color> line: dark ? #101921 : #e7e7e7;
    out property <color> border: dark ? #101921 : #e0e0e0;
    out property <color> selected: material
        ? (dark ? seed.darker(0.45) : seed.brighter(0.82))
        : fluent ? (dark ? #303b46 : #e6eff8)
        : (dark ? #2b5278 : #419fd9);
    out property <color> selected-ink: !material && !fluent ? #ffffff : ink;
    out property <color> selected-muted: !material && !fluent ? (dark ? #d6e9fb : #e5f5ff) : muted;
    out property <color> badge-bg: dark ? #3e546a : #bbbbbb;
    out property <color> outgoing-muted: dark ? #6c9cc4 : #70b15c;
    out property <color> outgoing-check: dark ? #62b1f6 : #5dc452;
    out property <color> outgoing: material
        ? (dark ? seed.darker(0.55) : seed.brighter(0.88))
        : (dark ? #2b5278 : #effdde);
    out property <length> control-radius: material ? 20px : fluent ? 8px : 10px;
    out property <length> bubble-radius: material ? 18px : fluent ? 10px : 6px;

    pure callback render-qr(string, int, color) -> image;
    callback open-link(string);
    in-out property <bool> context-pointer: false;
}

export component SendingClock inherits Rectangle {
    in property <color> tint: Theme.muted;
    width: 10px; height: 10px;
    border-radius: 5px; border-width: 1px; border-color: root.tint;
    Rectangle { x: 4px; y: 2px; width: 1px; height: 3px; background: root.tint; }
    Rectangle { x: 4px; y: 4px; width: 3px; height: 1px; background: root.tint; }
}

export component AvatarFill inherits Rectangle {
    in property <color> top;
    in property <color> bottom;
    border-radius: min(self.width, self.height) / 2;
    background: @linear-gradient(180deg, top 0%, bottom 100%);
}

// A single continuous outline avoids seams between the body and its tail.
// Preserve fractional logical coordinates until Skia applies the display scale.
export component BubbleShape inherits Rectangle {
    in property <color> fill;
    in property <length> radius: Theme.bubble-radius;
    in property <int> tail: 0; // 0 = none, 1 = incoming, 2 = outgoing
    in property <length> tail-width: 6px;
    property <float> l: tail == 1 ? tail-width / 1px : 0;
    property <float> r: (self.width - (tail == 2 ? tail-width : 0px)) / 1px;
    property <float> h: self.height / 1px;
    property <float> corner: min(radius / 1px, (r - l) / 2, h / 2);
    property <float> k: 0.55228475;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        fit: preserve;
        anti-alias: true;
        fill: root.fill;
        MoveTo { x: root.l + root.corner; y: 0; }
        LineTo { x: root.r - root.corner; y: 0; }
        CubicTo {
            control-1-x: root.r - root.corner * (1 - root.k); control-1-y: 0;
            control-2-x: root.r; control-2-y: root.corner * (1 - root.k);
            x: root.r; y: root.corner;
        }
        LineTo { x: root.r; y: root.h - (root.tail == 2 ? 10 : root.corner); }
        CubicTo {
            control-1-x: root.r;
            control-1-y: root.h - (root.tail == 2 ? 4 : root.corner * (1 - root.k));
            control-2-x: root.tail == 2 ? root.r + 2 : root.r - root.corner * (1 - root.k);
            control-2-y: root.h;
            x: root.tail == 2 ? root.width / 1px : root.r - root.corner;
            y: root.h;
        }
        LineTo { x: root.tail == 1 ? 0 : root.l + root.corner; y: root.h; }
        CubicTo {
            control-1-x: root.tail == 1 ? root.l - 2 : root.l + root.corner * (1 - root.k);
            control-1-y: root.h;
            control-2-x: root.l;
            control-2-y: root.h - (root.tail == 1 ? 4 : root.corner * (1 - root.k));
            x: root.l; y: root.h - (root.tail == 1 ? 10 : root.corner);
        }
        LineTo { x: root.l; y: root.corner; }
        CubicTo {
            control-1-x: root.l; control-1-y: root.corner * (1 - root.k);
            control-2-x: root.l + root.corner * (1 - root.k); control-2-y: 0;
            x: root.l + root.corner; y: 0;
        }
        Close { }
    }
}

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> selected: false;
    in property <bool> outlined: false;
    in property <bool> enabled: true;
    callback clicked();
    min-width: label.preferred-width + 24px;
    min-height: 36px;
    horizontal-stretch: 0;
    property <color> fill-color: primary ? Theme.accent : selected ? Theme.selected
        : pointer.has-hover ? Theme.hover : #00000000;
    opacity: enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: keyboard;
    if root.fill-color.alpha > 0 : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        border-radius: Theme.control-radius;
        background: root.fill-color;
    }
    if root.outlined && !root.primary : Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: Theme.control-radius;
        border-width: 1px;
        border-color: pointer.has-hover ? Theme.icon-hover-fg : Theme.border;
        background: transparent;
    }
    RippleSurface {
        border-radius: Theme.control-radius;
        pressed: pointer.pressed;
        press-x: pointer.mouse-x;
        press-y: pointer.mouse-y;
        ink: root.primary || root.selected ? Theme.active-ripple : Theme.ripple;
    }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.primary ? #ffffff : root.selected ? Theme.selected-ink : Theme.ink;
        font-size: 13px;
        font-weight: root.selected || root.primary ? 600 : root.outlined ? 500 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    keyboard := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    pointer := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { keyboard.focus(); root.clicked(); }
    }
}

export component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px;
    min-width: 190px;
    background: pointer.has-hover && enabled ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    RippleSurface {
        pressed: pointer.pressed;
        press-x: pointer.mouse-x;
        press-y: pointer.mouse-y;
        ink: Theme.ripple;
    }
    Text {
        x: 18px;
        width: parent.width - 36px;
        height: parent.height;
        text: root.text;
        color: Theme.ink;
        opacity: root.enabled ? 1 : 0.45;
        font-size: 13px;
        vertical-alignment: center;
    }
    pointer := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component Entry inherits Rectangle {
    in property <bool> placeholder-visible: true;
    in property <bool> read-only: false;
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> plain: false;
    callback edited();
    callback accepted();
    min-height: 34px;
    min-width: 80px;
    background: transparent;
    forward-focus: input;
    accessible-role: text-input;
    accessible-label: placeholder;
    accessible-value: text;
    accessible-action-set-value(value) => { root.text = value; root.edited(); }
    if !root.plain : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        border-radius: self.height / 2;
        background: Theme.dark ? #242f3d : #f1f1f1;
        border-color: Theme.accent;
        border-width: input.has-focus ? 2px : 0px;
    }
    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: root.plain ? 6px : 15px;
        padding-right: root.text != "" && !root.plain ? 32px : 14px;
        input := TextInput {
            text <=> root.text;
            single-line: true;
          read-only: root.read-only;
            color: Theme.ink;
            selection-background-color: Theme.accent;
            selection-foreground-color: #ffffff;
            font-size: 13px;
            vertical-alignment: center;
            edited => { root.edited(); }
            accepted => { root.accepted(); }
        }
    }
    if root.text == "" && root.placeholder-visible : Text {
        x: root.plain ? 6px : 15px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.muted;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.text != "" && !root.plain : Rectangle {
        x: parent.width - 30px;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        VectorIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: self.natural-width;
            height: self.natural-height;
            name: "close";
            tint: clear-hit.has-hover ? Theme.icon-hover-fg : Theme.icon-fg;
        }
        clear-hit := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.text = "";
                root.edited();
                input.focus();
            }
        }
    }
}

// Telegram's composer grows with wrapped lines and keeps Enter / Shift+Enter
// distinct. TextInput retains native cursor, selection, undo and IME behavior.
export component Composer inherits Rectangle {
    in property <bool> expanded: false;
    out property <int> line-count: round(measure.preferred-height / max(1px, baseline.preferred-height));
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> placeholder-visible: true;
    in property <bool> read-only: false;
    out property <length> content-height: clamp(46px + measure.preferred-height - baseline.preferred-height, 46px, 166px);
    callback accepted();
    callback edited();
    callback format-requested(string, int, int);
    out property <int> selection-start: input.anchor-position-byte-offset;
    out property <int> selection-end: input.cursor-position-byte-offset;
    forward-focus: input;
    clip: true;
    TouchArea { width: parent.width; height: parent.height; clicked => { input.focus(); } }
    baseline := Text { visible: false; text: " "; font-size: 13px; }
    measure := Text {
        visible: false;
        width: max(1px, root.width - 12px);
        text: root.text == "" ? " " : root.text;
        font-size: 13px;
        wrap: word-wrap;
    }
    if root.text == "" && root.placeholder-visible : Text {
        x: 6px; y: 0px; width: parent.width - 12px; height: 46px;
        text: root.placeholder; color: Theme.muted; font-size: 13px;
        vertical-alignment: center; overflow: elide;
    }
    scroll := Flickable {
        x: 6px; y: 14px; width: max(1px, parent.width - 12px);
        height: max(18px, parent.height - 28px);
        viewport-width: self.width;
        viewport-height: max(self.height, input.preferred-height);
        input := TextInput {
            width: scroll.width; height: max(scroll.height, self.preferred-height);
            text <=> root.text;
            font-size: 13px; color: Theme.ink;
            selection-background-color: Theme.accent;
            selection-foreground-color: #ffffff;
            single-line: false; wrap: word-wrap; read-only: root.read-only;
            edited => { root.edited(); }
            key-pressed(event) => {
                if event.modifiers.control {
                    if event.text == "v" || event.text == "V" || event.text == "м" || event.text == "М" || event.text == "\u{0016}" { if !root.read-only { input.paste(); } return accept; }
                    if event.text == "c" || event.text == "C" || event.text == "с" || event.text == "С" { input.copy(); return accept; }
                    if event.text == "x" || event.text == "X" || event.text == "ч" || event.text == "Ч" { if !root.read-only { input.cut(); } return accept; }
                    if event.text == "a" || event.text == "A" || event.text == "ф" || event.text == "Ф" { input.select-all(); return accept; }
                    if event.text == "b" || event.text == "B" || event.text == "и" || event.text == "И" { root.format-requested("bold", root.selection-start, root.selection-end); return accept; }
                    if event.text == "i" || event.text == "I" || event.text == "ш" || event.text == "Ш" { root.format-requested("italic", root.selection-start, root.selection-end); return accept; }
                    if event.text == "u" || event.text == "U" || event.text == "г" || event.text == "Г" { root.format-requested("underline", root.selection-start, root.selection-end); return accept; }
                    if event.text == "m" || event.text == "M" || event.text == "ь" || event.text == "Ь" { root.format-requested("code", root.selection-start, root.selection-end); return accept; }
                }
                if event.text == Key.Return && !event.modifiers.shift && !root.expanded {
                    if !root.read-only { root.accepted(); }
                    return accept;
                }
                return reject;
            }
            cursor-position-changed(position) => {
                if position.y + scroll.viewport-y < 0px { scroll.viewport-y = -position.y; }
                if position.y + scroll.viewport-y > scroll.height - 18px {
                    scroll.viewport-y = scroll.height - 18px - position.y;
                }
                scroll.viewport-y = clamp(scroll.viewport-y, min(0px, scroll.height - scroll.viewport-height), 0px);
            }
        }
    }
    public function edit-action(action: string) {
        if action == "paste" { if !root.read-only { input.paste(); } }
        else if action == "copy" { input.copy(); }
        else if action == "cut" { if !root.read-only { input.cut(); } }
        else if action == "select-all" { input.select-all(); }
        else { root.format-requested(action, root.selection-start, root.selection-end); }
        input.focus();
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> active: false;
    callback clicked();
    width: 40px;
    height: 40px;
    background: transparent;
    opacity: enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: keyboard;
    RippleSurface {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width, parent.height);
        height: self.width;
        border-radius: self.width / 2;
        pressed: hit.pressed;
        press-x: hit.mouse-x - self.x;
        press-y: hit.mouse-y - self.y;
        ink: Theme.ripple;
    }
    VectorIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: self.natural-width;
        height: self.natural-height;
        name: root.icon;
        tint: root.active ? Theme.accent : hit.has-hover && root.enabled ? Theme.icon-hover-fg : Theme.icon-fg;
    }
    keyboard := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    hit := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { keyboard.focus(); root.clicked(); }
    }
}
